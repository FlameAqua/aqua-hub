<UserControl x:Class="AquaHub.UI.Pages.TodayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="32,26,32,36" MaxWidth="1560">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource T.Display}"/>
                    <TextBlock Text="{Binding Subline}" Style="{StaticResource T.Body2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Refresh lives in the title bar (and F5); the page's one primary action is listening to the brief. -->
                    <Button Style="{StaticResource Btn.Accent}" Command="{Binding ReadBriefCommand}" AutomationProperties.AutomationId="read-brief"
                            AutomationProperties.Name="{Binding ReadLabel}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="{Binding ReadIcon}" Width="15" Height="15"/>
                            <TextBlock Text="{Binding ReadLabel}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <c:FlowGrid MaxColumns="3" MinColumnWidth="340" Gap="16">

                <!-- ═══ Daily brief (hero) ═══ -->
                <c:Card c:FlowGrid.Span="2" Title="{Binding BriefTitle}" Icon="sparkle" Badge="{Binding BriefBadge}" Subtitle="{Binding BriefMeta}"
                        Background="{DynamicResource B.Hero}" BorderBrush="{DynamicResource B.AccentSoft}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Subtle}" Command="{Binding RegenerateBriefCommand}" ToolTip="Write a fresh brief now" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="refresh" Width="13" Height="13"/>
                                <TextBlock Text="Regenerate" FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </c:Card.HeaderAction>
                    <Grid>
                        <StackPanel Visibility="{Binding HasBrief, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding BriefSummary}" FontSize="16" LineHeight="25" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding BriefSections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <c:FlowGrid MaxColumns="2" MinColumnWidth="280" Gap="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardInner}" Padding="14,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <c:Icon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource B.AccentText}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Bullets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource B.Text3}" VerticalAlignment="Top" Margin="1,8,0,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasBrief, Converter={StaticResource VisNot}}">
                            <c:Shimmer Height="18" Margin="0,2,80,8"/>
                            <c:Shimmer Height="18" Margin="0,0,160,16"/>
                            <TextBlock Text="Your brief appears here in a moment."
                                       Style="{StaticResource T.Body2}"/>
                        </StackPanel>
                    </Grid>
                </c:Card>

                <!-- ═══ Weather ═══ -->
                <c:Card Title="Weather" Icon="cloud" Subtitle="{Binding WeatherLocation}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <c:WeatherIcon Code="{Binding WeatherCode}" IsDay="{Binding IsDay}" Width="76" Height="76" Margin="-4,-6,6,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Temp}" FontFamily="{StaticResource F.Display}" FontSize="46" FontWeight="Light" Foreground="{DynamicResource B.Text}"/>
                                        <StackPanel VerticalAlignment="Center" Margin="12,4,0,0">
                                            <TextBlock Text="{Binding Condition}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding HiLo}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource T.Caption}" Margin="0,4,0,12"/>
                            <ItemsControl ItemsSource="{Binding Hours}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource T.Caption}" HorizontalAlignment="Center"/>
                                            <c:WeatherIcon Code="{Binding Code}" IsDay="{Binding IsDay}" Width="26" Height="26" Margin="0,4"/>
                                            <TextBlock Text="{Binding Temp}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Rain}" FontSize="10" Foreground="{DynamicResource B.Info}" HorizontalAlignment="Center" Height="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Style="{StaticResource Divider}" Margin="0,10"/>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Day}" FontSize="13" VerticalAlignment="Center"/>
                                            <c:WeatherIcon Grid.Column="1" Code="{Binding Code}" Width="22" Height="22"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Rain}" FontSize="11" Foreground="{DynamicResource B.Info}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Min}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                            <c:RangeBar Grid.Column="4" Start="{Binding BarStart}" Length="{Binding BarWidth}" Fill="{DynamicResource B.Brand}"
                                                        Track="{DynamicResource B.Track}" Height="5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Max}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding WeatherLoading, Converter={StaticResource Vis}}">
                            <c:Shimmer Height="60" Margin="0,0,0,10"/>
                            <c:Shimmer Height="120"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NeedsPlace, Converter={StaticResource Vis}}">
                            <TextBlock Text="Choose your town to see its weather." Style="{StaticResource T.Body2}" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource Btn.Standard}" Command="{Binding SetPlace}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    AutomationProperties.Name="Choose a place" AutomationProperties.AutomationId="weather-set-place">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="location" Width="14" Height="14"/><TextBlock Text="Choose a place" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </c:Card>

                <!-- ═══ Top stories ═══ -->
                <c:Card c:FlowGrid.Span="2" Title="Top stories" Icon="news" Subtitle="{Binding StoriesSubtitle}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding Go}" CommandParameter="news">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="All news"/><c:Icon Kind="chevron-right" Width="12" Height="12" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                    </c:Card.HeaderAction>
                    <Grid>
                        <StackPanel Visibility="{Binding HasStories, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding TopStories}" ItemTemplate="{StaticResource Tpl.StoryRow}"/>
                            <TextBlock Text="Near you" Style="{StaticResource T.Overline}" Margin="0,10,0,4" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding LocalStories}" ItemTemplate="{StaticResource Tpl.StoryRow}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasStories, Converter={StaticResource VisNot}}">
                            <c:Shimmer Height="44" Margin="0,0,0,10"/>
                            <c:Shimmer Height="44" Margin="0,0,0,10"/>
                            <c:Shimmer Height="44"/>
                        </StackPanel>
                    </Grid>
                </c:Card>

                <!-- ═══ Markets ═══ -->
                <c:Card Title="Markets" Icon="markets" Subtitle="{Binding MarketsSubtitle}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding Go}" CommandParameter="markets">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Details"/><c:Icon Kind="chevron-right" Width="12" Height="12" Margin="4,0,0,0"/></StackPanel>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Indices}" ItemTemplate="{StaticResource Tpl.QuoteRow}"/>
                        <TextBlock Text="Watchlist movers" Style="{StaticResource T.Overline}" Margin="0,10,0,2" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding Movers}" ItemTemplate="{StaticResource Tpl.QuoteRow}"/>
                        <Border Style="{StaticResource CardInner}" Margin="0,10,0,0" Visibility="{Binding MarketLine, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <c:Icon Kind="sparkle" Width="12" Height="12" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding MarketLine}" Style="{StaticResource T.Body2}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <c:Shimmer Height="120" Visibility="{Binding HasMarkets, Converter={StaticResource VisNot}}"/>
                    </StackPanel>
                </c:Card>

                <!-- ═══ Social pulse ═══ -->
                <c:Card Title="Local pulse" Icon="social" Badge="{Binding PulseBadge}" Subtitle="{Binding PulseMeta}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding Go}" CommandParameter="social" ToolTip="Open social pulse" Width="28" Height="28">
                            <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <TextBlock Text="{Binding PulseOverview}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding PulseTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource B.Subtle}" VerticalAlignment="Top">
                                            <c:Icon Kind="fire" Width="15" Height="15" Foreground="{Binding SentimentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,54,0"/>
                                                <c:Bar Value="{Binding HeatValue}" Width="44" Height="4" HorizontalAlignment="Right" Fill="{Binding SentimentBrush}" Track="{DynamicResource B.Track}"
                                                       ToolTip="How much people are talking about it"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="WordEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:Shimmer Height="90" Visibility="{Binding HasPulse, Converter={StaticResource VisNot}}"/>
                    </StackPanel>
                </c:Card>

                <!-- ═══ Upcoming ═══ -->
                <c:Card Title="Coming up" Icon="upcoming">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding Go}" CommandParameter="upcoming" ToolTip="Open agenda" Width="28" Height="28">
                            <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource Tpl.EventRow}"/>
                        <TextBlock Text="Nothing scheduled — add a calendar in Settings → Agenda." Style="{StaticResource T.Body2}"
                                   Visibility="{Binding Events, Converter={StaticResource VisNot}}"/>
                    </StackPanel>
                </c:Card>

                <!-- ═══ Predictions ═══ -->
                <c:Card Title="What the crowd expects" Icon="target">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding Go}" CommandParameter="upcoming" ToolTip="All predictions" Width="28" Height="28">
                            <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Predictions}" ItemTemplate="{StaticResource Tpl.PredictionRow}"/>
                        <c:Shimmer Height="120" Visibility="{Binding Predictions, Converter={StaticResource VisNot}}"/>
                    </StackPanel>
                </c:Card>

                <!-- ═══ Now playing ═══ -->
                <c:Card Title="Now playing" Icon="music" Subtitle="{Binding MediaApp}">
                    <StackPanel>
                        <Grid Visibility="{Binding HasMedia, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource B.Brand}">
                                <Grid>
                                    <c:Icon Kind="music" Width="26" Height="26" Foreground="White" Visibility="{Binding HasArt, Converter={StaticResource VisNot}}"/>
                                    <Border CornerRadius="10" ClipToBounds="True">
                                        <Border.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="10" RadiusY="10"/></Border.Clip>
                                        <Image Source="{Binding MediaArt}" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource T.Caption}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasMedia, Converter={StaticResource VisNot}}">
                            <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource B.Subtle}">
                                <c:Icon Kind="headphones" Width="26" Height="26" Foreground="{DynamicResource B.Text3}"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Nothing playing" FontSize="14" FontWeight="SemiBold"/>
                                <Button Style="{StaticResource Btn.Link}" Command="{Binding OpenMusicCommand}" Margin="-6,2,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding MusicAppName, StringFormat='Play something on {0}'}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Media}" Command="{Binding PrevCommand}" ToolTip="Previous"><c:Icon Kind="previous" Width="16" Height="16"/></Button>
                                <Button Style="{StaticResource Btn.MediaMain}" Command="{Binding PlayPauseCommand}" ToolTip="Play / pause" Margin="6,0"><c:Icon Kind="{Binding PlayIcon}" Width="18" Height="18"/></Button>
                                <Button Style="{StaticResource Btn.Media}" Command="{Binding NextCommand}" ToolTip="Next"><c:Icon Kind="next" Width="16" Height="16"/></Button>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Btn.Icon}" Command="{Binding MuteCommand}" Width="28" Height="28" ToolTip="Mute">
                                    <c:Icon Kind="{Binding VolumeIcon}" Width="15" Height="15"/>
                                </Button>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" Margin="4,0,0,0" ToolTip="Volume" AutomationProperties.Name="Volume"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </c:Card>

                <!-- ═══ This PC ═══ -->
                <c:Card Title="This PC" Icon="system" Subtitle="{Binding UptimeText}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding Go}" CommandParameter="system" ToolTip="Open system view" Width="28" Height="28">
                            <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <StackPanel ToolTip="Processor load">
                                <c:RingGauge AutomationProperties.Name="Processor load" Value="{Binding Cpu}" ValueBrush="{Binding CpuBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="72" Height="72"/>
                                <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource T.Caption}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel ToolTip="Memory in use">
                                <c:RingGauge AutomationProperties.Name="Memory in use" Value="{Binding Ram}" ValueBrush="{Binding RamBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="72" Height="72"/>
                                <TextBlock Text="Memory" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource T.Caption}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel ToolTip="Graphics load">
                                <c:RingGauge AutomationProperties.Name="Graphics load" Value="{Binding Gpu}" ValueBrush="{Binding GpuBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="72" Height="72"/>
                                <TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource T.Caption}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,2">
                            <TextBlock Text="VRAM" Style="{StaticResource T.Caption}"/>
                            <TextBlock Text="{Binding VramText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <c:Bar Value="{Binding VramValue}" Fill="{DynamicResource B.Accent}" Track="{DynamicResource B.Track}" Height="5" Margin="0,4,0,10"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="System drive" Style="{StaticResource T.Caption}"/>
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <c:Bar Value="{Binding DiskValue}" Fill="{DynamicResource B.Info}" Track="{DynamicResource B.Track}" Height="5" Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding NetText}" Style="{StaticResource T.Caption}"/>
                    </StackPanel>
                </c:Card>

                <!-- ═══ Launchpad ═══ -->
                <c:Card Title="Launchpad" Icon="launchpad">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource Btn.Icon}" Command="{Binding Go}" CommandParameter="launchpad" ToolTip="Manage apps &amp; scenes" Width="28" Height="28">
                            <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PinnedApps}" ItemTemplate="{StaticResource Tpl.AppTile}" Margin="-4,0,-4,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Scenes" Style="{StaticResource T.Overline}" FontSize="12" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding Scenes}" ItemTemplate="{StaticResource Tpl.ScenePill}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </c:Card>
            </c:FlowGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
