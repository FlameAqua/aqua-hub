<UserControl x:Class="AquaHub.UI.Pages.UpcomingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <UserControl.Resources>
        <Style TargetType="DatePicker">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Padding="6,4"
                                               AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                                <DatePickerTextBox.Style>
                                    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
                                </DatePickerTextBox.Style>
                            </DatePickerTextBox>
                            <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource Btn.Icon}"
                                    Width="28" Height="28" Margin="2,0,0,0" ToolTip="Open calendar"
                                    AutomationProperties.Name="Open calendar">
                                <c:Icon Kind="upcoming" Width="14" Height="14"/>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36" MaxWidth="1560">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Standard}" Margin="12,0,0,0"
                        Content="Add calendar" VerticalAlignment="Center" Click="OnAddCalendar"
                        AutomationProperties.HelpText="Add a calendar using an ICS link or a local .ics file.">
                    <Button.ToolTip><TextBlock Text="Add an ICS link from your calendar provider or choose a local .ics file." Width="240" TextWrapping="Wrap"/></Button.ToolTip>
                </Button>
                <TextBlock Text="Upcoming &amp; predictions" Style="{StaticResource T.Title}" TextWrapping="Wrap"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Agenda -->
                <c:Card Title="Agenda" Icon="upcoming" VerticalAlignment="Top">
                    <c:Card.HeaderAction>
                        <Button x:Name="AddReminder" Style="{StaticResource Btn.Standard}" Content="Add reminder"
                                Click="OnAddReminder" AutomationProperties.AutomationId="agenda-add-reminder"/>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <WrapPanel x:Name="DayControls" Margin="0,0,0,6">
                            <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Click="OnPreviousDay"
                                    ToolTip="Previous day" AutomationProperties.Name="Previous day" AutomationProperties.AutomationId="agenda-previous">
                                <c:Icon Kind="chevron-left" Width="14" Height="14"/>
                            </Button>
                            <DatePicker x:Name="AgendaDate" Width="126" Margin="4,0" SelectedDateChanged="OnDaySelected"
                                        DateValidationError="OnAgendaDateInvalid"
                                        SelectedDateFormat="Short" VerticalAlignment="Center"
                                        AutomationProperties.Name="Agenda date" AutomationProperties.AutomationId="agenda-date"/>
                            <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Click="OnNextDay"
                                    ToolTip="Next day" AutomationProperties.Name="Next day" AutomationProperties.AutomationId="agenda-next">
                                <c:Icon Kind="chevron-right" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource Btn.Link}" Content="Today" Click="OnToday" Margin="6,0"
                                    AutomationProperties.AutomationId="agenda-today"/>
                            <Button x:Name="AllReminders" Style="{StaticResource Btn.Link}" Content="All reminders"
                                    Click="OnAllReminders" Margin="6,0,0,0" AutomationProperties.AutomationId="agenda-all-reminders"/>
                        </WrapPanel>
                        <TextBlock x:Name="AgendaHeading" Style="{StaticResource T.Caption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="agenda-day-heading"/>
                        <Border x:Name="ReminderEditor" Style="{StaticResource CardInner}" Margin="0,0,0,10"
                                Visibility="Collapsed" PreviewKeyDown="OnEditorKey">
                            <StackPanel x:Name="EditorFields">
                                <StackPanel.Resources>
                                    <Style TargetType="Label">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock x:Name="EditorHeading" FontWeight="SemiBold"/>
                                <Label Content="_Title" Target="{Binding ElementName=ReminderTitle}"/>
                                <TextBox x:Name="ReminderTitle" AutomationProperties.Name="Reminder title"
                                         AutomationProperties.AutomationId="reminder-title" MaxLength="120"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,6">
                                        <Label Content="_Date" Target="{Binding ElementName=ReminderDate}"/>
                                        <DatePicker x:Name="ReminderDate" Width="126" SelectedDateFormat="Short"
                                                    DateValidationError="OnReminderDateInvalid"
                                                    AutomationProperties.Name="Reminder date" AutomationProperties.AutomationId="reminder-date"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,6">
                                        <Label Content="Ti_me (24-hour)" Target="{Binding ElementName=ReminderTime}"/>
                                        <TextBox x:Name="ReminderTime" Width="112" MaxLength="5"
                                                 AutomationProperties.Name="Reminder time (24-hour)" AutomationProperties.AutomationId="reminder-time"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <Label Content="_Repeat" Target="{Binding ElementName=ReminderRepeatBox}"/>
                                        <ComboBox x:Name="ReminderRepeatBox" Width="108" MinWidth="96" SelectedIndex="0"
                                                  AutomationProperties.Name="Repeat reminder" AutomationProperties.AutomationId="reminder-repeat">
                                            <ComboBoxItem Content="Once"/>
                                            <ComboBoxItem Content="Daily"/>
                                            <ComboBoxItem Content="Weekly"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <Label Content="Scene action (optional)" Target="{Binding ElementName=ReminderSceneBox}"/>
                                <ComboBox x:Name="ReminderSceneBox" DisplayMemberPath="Name" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="Scene action" AutomationProperties.AutomationId="reminder-scene"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Btn.Accent}" Content="Save" Click="OnSaveReminder"
                                            AutomationProperties.AutomationId="reminder-save"/>
                                    <Button Style="{StaticResource Btn.Standard}" Content="Cancel" Click="OnCancelEditor" Margin="6,0,0,0"
                                            AutomationProperties.AutomationId="reminder-cancel"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SceneReviewPanel" Style="{StaticResource CardInner}" Margin="0,0,0,10"
                                Visibility="Collapsed" PreviewKeyDown="OnSceneReviewKey">
                            <StackPanel>
                                <TextBlock x:Name="SceneReviewTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="reminder-scene-review-title"/>
                                <ListBox x:Name="SceneReviewSteps" MaxHeight="176" Margin="0,6,0,8" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource B.Text}" HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Scene steps"
                                         AutomationProperties.AutomationId="reminder-scene-review-steps">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Style="{StaticResource Btn.Accent}" Content="Run now" Click="OnConfirmScene"
                                            AutomationProperties.AutomationId="reminder-scene-confirm"/>
                                    <Button x:Name="CancelSceneReview" Style="{StaticResource Btn.Standard}" Content="Cancel"
                                            Click="OnCancelSceneReview" Margin="6,0,0,0" AutomationProperties.AutomationId="reminder-scene-cancel"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AgendaEmpty" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="AgendaList" AutomationProperties.Name="Agenda entries" AutomationProperties.AutomationId="agenda-entries">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,1,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="agenda-entry-title"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"/>
                                            <WrapPanel Visibility="{Binding Editable, Converter={StaticResource Vis}}">
                                                <Button Style="{StaticResource Btn.Link}" Content="Run scene" Click="OnReviewScene"
                                                        Visibility="{Binding CanRunScene, Converter={StaticResource Vis}}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="{Binding RunSceneName}" AutomationProperties.AutomationId="reminder-run-scene"/>
                                                <Button Style="{StaticResource Btn.Link}" Content="Done" Click="OnReminderDone"
                                                        AutomationProperties.Name="{Binding DoneName}" AutomationProperties.AutomationId="reminder-done"
                                                        Visibility="{Binding Actionable, Converter={StaticResource Vis}}" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource Btn.Link}" Content="Snooze 10 minutes" Click="OnReminderSnooze"
                                                        AutomationProperties.Name="{Binding SnoozeName}" AutomationProperties.AutomationId="reminder-snooze"
                                                        Visibility="{Binding CanSnooze, Converter={StaticResource Vis}}" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource Btn.Link}" Content="Edit" Click="OnReminderEdit"
                                                        AutomationProperties.Name="{Binding EditName}" AutomationProperties.AutomationId="reminder-edit" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource Btn.Link}" Content="Delete" Click="OnReminderDelete"
                                                        AutomationProperties.Name="{Binding DeleteName}" AutomationProperties.AutomationId="reminder-delete"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="PreviousAgendaItems" Style="{StaticResource Btn.Link}" Content="Previous events"
                                    Click="OnPreviousAgendaItems" Visibility="Collapsed" Margin="0,0,8,0"/>
                            <Button x:Name="MoreAgendaItems" Style="{StaticResource Btn.Link}" Content="Next events"
                                    Click="OnMoreAgendaItems" Visibility="Collapsed"/>
                        </WrapPanel>
                    </StackPanel>
                </c:Card>

                <StackPanel Grid.Column="2">
                    <!-- Foresight -->
                    <c:Card Title="Foresight" Icon="sparkle" Badge="{Binding ForesightBadge}" Subtitle="{Binding ForesightMeta}"
                            Background="{DynamicResource B.Hero}" BorderBrush="{DynamicResource B.AccentSoft}">
                        <StackPanel>
                            <TextBlock Text="{Binding ForesightOverview}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ForesightItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardInner}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource B.Subtle}" VerticalAlignment="Top">
                                                    <c:Icon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{Binding Brush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,90,0"/>
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body2}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </c:Card>

                </StackPanel>
            </Grid>

            <!-- Predictions -->
            <TextBlock Text="Prediction markets" Style="{StaticResource T.Subtitle}" Margin="2,24,0,4"/>
            <TextBlock Text="Odds from prediction markets: sentiment, not certainty." Style="{StaticResource T.Caption}" Margin="2,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Predictions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:FlowGrid MaxColumns="3" MinColumnWidth="320" Gap="12"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.CardStroke}"
                                BorderThickness="1" ui:UiProps.CornerRadius="12" Padding="16,14" ToolTip="Open on the market's website" AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Outcomes}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" FontWeight="{Binding LabelWeight}" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ChangeText}" FontSize="11" Foreground="{Binding ChangeBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding ProbText}" Style="{StaticResource T.Number}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                                <c:Bar Value="{Binding Probability}" Fill="{Binding BarBrush}" Track="{DynamicResource B.Track}" Height="5" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
        <Button x:Name="CancelSceneRun" Style="{StaticResource Btn.Standard}" Content="Stop scene" Click="OnStopScene"
                Visibility="Collapsed" Margin="4,0" AutomationProperties.AutomationId="reminder-scene-stop"/>
        <Button x:Name="AgendaRetry" Style="{StaticResource Btn.Standard}" Content="Retry reminders" Click="OnRetryReminders"
                Visibility="Collapsed" Margin="4,0" AutomationProperties.AutomationId="agenda-retry"/>
    </StackPanel>
    <c:FeedbackPopup x:Name="AgendaFeedback"/>
    </Grid>
</UserControl>
