<UserControl x:Class="AquaHub.UI.Pages.NewsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI"
             xmlns:svc="clr-namespace:AquaHub.Services">
    <Grid Margin="32,26,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and filters share the story column's width (max 1100, centred like the cards; the 24 px on the right
             match the list's padding plus its scrollbar), so on wide screens they line up with the cards. -->
        <Grid Margin="0,0,24,14" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="News" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource T.Body2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBox x:Name="Search" Grid.Column="1" Width="280" Margin="16,0,0,0" VerticalAlignment="Center" ui:UiProps.Placeholder="Filter stories or outlets…"
                     TextChanged="OnFilterChanged" AutomationProperties.Name="Filter stories"/>
        </Grid>

        <WrapPanel x:Name="Filters" Grid.Row="1" Margin="0,0,24,8" MaxWidth="1100"/>

        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource PlainList}" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" Padding="0,0,12,24">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="0,0,0,12" MaxWidth="1100" HorizontalAlignment="Stretch"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <!-- Meta row -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource B.Subtle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding CategoryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource B.Text2}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource B.InfoSoft}" Margin="6,0,0,0"
                                            Visibility="{Binding MultiSource, Converter={StaticResource Vis}}" ToolTip="Cross-checked: several independent outlets report this story">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="layers" Width="11" Height="11" Foreground="{DynamicResource B.Info}"/>
                                            <TextBlock Text="{Binding CoverageText}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource B.Info}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding TimeAgoPhrase}" Style="{StaticResource T.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource B.AccentSoft}" Margin="8,0,0,0" Visibility="{Binding IsAi, Converter={StaticResource Vis}}"
                                            ToolTip="{Binding Model, StringFormat='Summarised on-device by {0}'}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="sparkle" Width="10" Height="10" Foreground="{DynamicResource B.AccentText}"/>
                                            <TextBlock Text="AI summary" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{DynamicResource B.AccentText}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Interests, StringFormat='· matches {0}'}" Style="{StaticResource T.Caption}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource B.AccentText}" Visibility="{Binding Interests, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding SaveCommand}" ToolTip="Save for later">
                                        <c:Icon Kind="{Binding SaveIcon}" Width="15" Height="15"/>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding CopyCommand}" ToolTip="Copy link">
                                        <c:Icon Kind="link" Width="15" Height="15"/>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding AskCommand}" ToolTip="Ask Aqua about this story">
                                        <c:Icon Kind="ask" Width="15" Height="15"/>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding OpenCommand}" ToolTip="Open the article">
                                        <c:Icon Kind="external" Width="15" Height="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="26"/>
                                    <TextBlock Text="{Binding Tldr}" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text2}" Margin="0,6,0,0" FontSize="14.5"
                                               Visibility="{Binding Tldr, Converter={StaticResource Vis}}"/>
                                    <ItemsControl ItemsSource="{Binding KeyPoints}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource B.AccentText}" VerticalAlignment="Top" Margin="3,8,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" FontSize="13.5"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource CardInner}" Margin="0,10,0,0" Padding="12,8" Visibility="{Binding Why, Converter={StaticResource Vis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <c:Icon Kind="info" Width="14" Height="14" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Why}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Width="200" Height="128" CornerRadius="10" Margin="18,2,0,0" VerticalAlignment="Top" Background="{DynamicResource B.Skeleton}"
                                        Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                                    <Border.Clip><RectangleGeometry Rect="0,0,200,128" RadiusX="10" RadiusY="10"/></Border.Clip>
                                    <Image svc:Img.Url="{Binding ImageUrl}" svc:Img.DecodeWidth="400" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>

                            <!-- Sources -->
                            <ItemsControl ItemsSource="{Binding Sources}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Btn.Standard}" Command="{Binding Open}" Padding="9,3" FontSize="12" Margin="0,0,6,0" ui:UiProps.CornerRadius="12"
                                                ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Name, StringFormat=Read on {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"/>
                                                <c:Icon Kind="external" Width="10" Height="10" Margin="5,0,0,0" Foreground="{DynamicResource B.Text3}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="NewStories" Grid.Row="2" Style="{StaticResource Btn.Accent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Padding="14,6" ui:UiProps.CornerRadius="16" Click="OnShowNew" Visibility="Collapsed" AutomationProperties.AutomationId="news-new-stories">
            <Button.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3"/></Button.Effect>
            <StackPanel Orientation="Horizontal">
                <c:Icon Kind="arrow-up" Width="13" Height="13"/>
                <TextBlock x:Name="NewStoriesText" Text="New stories" Margin="7,0,0,0" FontSize="13"/>
            </StackPanel>
        </Button>

        <StackPanel x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <c:Icon Kind="news" Width="40" Height="40" Foreground="{DynamicResource B.Text3}"/>
            <TextBlock x:Name="EmptyText" Text="No stories match." Style="{StaticResource T.Body2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
