<UserControl x:Class="AquaHub.UI.Pages.LaunchpadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36" MaxWidth="1560">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Launchpad" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource T.Body2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Now playing -->
                <c:Card Title="Now playing" Icon="music" DataContext="{Binding Today}" Subtitle="{Binding MediaApp}" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Height="220" CornerRadius="14" Background="{DynamicResource B.Brand}">
                            <Grid>
                                <c:Icon Kind="headphones" Width="64" Height="64" Foreground="#CCFFFFFF" Visibility="{Binding HasArt, Converter={StaticResource VisNot}}"/>
                                <Border CornerRadius="14" ClipToBounds="True" x:Name="ArtHost">
                                    <Image Source="{Binding MediaArt}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding MediaTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasMedia, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource T.Body2}" Margin="0,2,0,0" Visibility="{Binding HasMedia, Converter={StaticResource Vis}}"/>
                        <StackPanel Visibility="{Binding HasMedia, Converter={StaticResource VisNot}}" Margin="0,16,0,0">
                            <TextBlock Text="Nothing is playing" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Works with any app in Windows' media controls, such as Spotify, browsers and Media Player." Style="{StaticResource T.Body2}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,8">
                            <Button Style="{StaticResource Btn.Media}" Width="48" Height="48" ui:UiProps.CornerRadius="24" Command="{Binding PrevCommand}" ToolTip="Previous"><c:Icon Kind="previous" Width="20" Height="20"/></Button>
                            <Button Style="{StaticResource Btn.MediaMain}" Width="60" Height="60" ui:UiProps.CornerRadius="30" Command="{Binding PlayPauseCommand}" Margin="14,0" ToolTip="Play / pause"><c:Icon Kind="{Binding PlayIcon}" Width="24" Height="24"/></Button>
                            <Button Style="{StaticResource Btn.Media}" Width="48" Height="48" ui:UiProps.CornerRadius="24" Command="{Binding NextCommand}" ToolTip="Next"><c:Icon Kind="next" Width="20" Height="20"/></Button>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Btn.Icon}" Command="{Binding MuteCommand}" ToolTip="Mute"><c:Icon Kind="{Binding VolumeIcon}" Width="16" Height="16"/></Button>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" Margin="6,0" AutomationProperties.Name="Volume"/>
                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <TextBox x:Name="MusicQuery" ui:UiProps.Placeholder="Play something — artist, album, mood…" KeyDown="OnMusicKey" Margin="0,0,44,0"/>
                            <Button Style="{StaticResource Btn.Accent}" HorizontalAlignment="Right" Width="38" Height="34" Padding="0" Click="OnMusicSearch" ToolTip="Search in your music app">
                                <c:Icon Kind="search" Width="15" Height="15"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </c:Card>

                <StackPanel Grid.Column="2">
                    <!-- Scenes -->
                    <c:Card Title="Scenes" Icon="wand" Subtitle="one click, several actions">
                        <ItemsControl ItemsSource="{Binding Scenes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><c:FlowGrid MaxColumns="2" MinColumnWidth="260" Gap="12"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInner}" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" VerticalAlignment="Top">
                                                <c:Icon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource B.AccentText}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding StepsText}" FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Standard}" Command="{Binding RunCommand}" Padding="12,5" FontSize="13" VerticalAlignment="Top" Content="Run" AutomationProperties.Name="{Binding Name, StringFormat=Run {0}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:Card>

                    <!-- Apps -->
                    <c:Card Title="Apps" Icon="launchpad" Margin="0,16,0,0" Subtitle="right-click an app for more">
                        <c:Card.HeaderAction>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="EditApps" Style="{StaticResource Btn.Standard}" Padding="10,4" Margin="0,0,8,0" Checked="OnEditApps" Unchecked="OnEditApps"
                                              AutomationProperties.AutomationId="launchpad-edit-apps" ToolTip="Remove apps from the Launchpad">
                                    <TextBlock x:Name="EditAppsText" Text="Edit" FontSize="13"/>
                                </ToggleButton>
                                <Button Style="{StaticResource Btn.Standard}" Click="OnAddApp" Padding="10,4">
                                    <StackPanel Orientation="Horizontal"><c:Icon Kind="plus" Width="13" Height="13"/><TextBlock Text="Add app" FontSize="13" Margin="6,0,0,0"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </c:Card.HeaderAction>
                        <StackPanel>
                            <ItemsControl x:Name="AppGrid" ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource Tpl.AppTile}" Margin="-4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- App picker -->
                            <Border x:Name="Picker" Style="{StaticResource CardInner}" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <TextBox x:Name="PickerSearch" ui:UiProps.Placeholder="Search installed apps…" TextChanged="OnPickerSearch" Margin="0,0,44,0"/>
                                        <Button Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right" Click="OnClosePicker" ToolTip="Close"><c:Icon Kind="close" Width="14" Height="14"/></Button>
                                    </Grid>
                                    <ListBox x:Name="PickerList" Style="{StaticResource PlainList}" MaxHeight="280" Margin="0,8,0,0" MouseUp="OnPickApp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <c:Icon Kind="plus" Width="13" Height="13" Foreground="{DynamicResource B.AccentText}"/>
                                                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
