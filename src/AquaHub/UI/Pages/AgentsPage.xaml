<UserControl x:Class="AquaHub.UI.Pages.AgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <Grid>
    <ScrollViewer x:Name="AgentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36" MaxWidth="1560">
          <StackPanel x:Name="AgentDashboard">
            <StackPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Agents" Style="{StaticResource T.Title}"/>
                    <TextBlock x:Name="Subtitle" Style="{StaticResource T.Body2}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <c:Card Title="Your recipes" Icon="book" Margin="0,0,0,18">
                <StackPanel>
                    <Button x:Name="GoToRecipes" Content="Open Workbench" Style="{StaticResource Btn.Standard}" Click="OnGoToRecipes"
                            HorizontalAlignment="Left" AutomationProperties.AutomationId="agents-recipe-workbench"/>
                    <TextBlock x:Name="RecipesEmpty" Style="{StaticResource T.Body2}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="AgentRecipes" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Link}" Click="OnOpenRecipe"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        AutomationProperties.Name="{Binding Draft.Name, StringFormat=View recipe {0}}"
                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=agents-recipe-{0}}">
                                    <TextBlock Text="{Binding Draft.Name}" TextWrapping="Wrap"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:Card>

            <TextBlock Text="Built-in agents" Style="{StaticResource T.CardTitle}"/>
            <WrapPanel Margin="0,8,0,14">
                    <Button x:Name="OllamaButton" Style="{StaticResource Btn.Standard}" Click="OnToggleOllama" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="agents-ollama-toggle" ToolTip="The local model server the AI agents use">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OllamaDot" Width="8" Height="8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OllamaText" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Standard}" Click="OnPauseAll" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><c:Icon x:Name="PauseIcon" Kind="pause" Width="14" Height="14"/><TextBlock x:Name="PauseText" Text="Pause all" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Accent}" Click="OnRunAll">
                        <StackPanel Orientation="Horizontal"><c:Icon Kind="refresh" Width="14" Height="14"/><TextBlock Text="Run all now" Margin="8,0,0,0"/></StackPanel>
                    </Button>
            </WrapPanel>

            <ItemsControl x:Name="Stages">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:FlowGrid MaxColumns="4" MinColumnWidth="300" Gap="16"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource B.AccentSoft}">
                                    <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Agents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14" ToolTip="{Binding Description}">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                                                            <Ellipse Fill="{Binding StateBrush}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource B.AccentSoft}" Margin="8,0,0,0" Visibility="{Binding UsesAi, Converter={StaticResource Vis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <c:Icon Kind="sparkle" Width="9" Height="9" Foreground="{DynamicResource B.AccentText}"/>
                                                                <TextBlock Text="AI" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" Margin="3,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" HorizontalAlignment="Right" Command="{Binding RunCommand}" ToolTip="Run now" AutomationProperties.Name="{Binding Name, StringFormat=Run {0} now}">
                                                        <c:Icon Kind="play" Width="12" Height="12"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{Binding StateBrush}" Margin="18,2,0,0"/>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" Margin="0,8,0,0" MaxHeight="58" Visibility="{Binding Message, Converter={StaticResource Vis}}"/>
                                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding FooterText, Mode=OneWay}"/>
                                                <Button Content="Details" Style="{StaticResource Btn.Link}" Click="OnOpenAgent" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=View details for {0}}"
                                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=agents-detail-{0}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <c:Card Title="Activity" Icon="clock" Subtitle="most recent runs">
                    <ItemsControl x:Name="Runs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource T.Caption}"/>
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Brush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Agent}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:Card>
                <c:Card Grid.Column="2" Title="Model output inspector" Icon="eye" Subtitle="what the local model actually said">
                    <StackPanel>
                        <TextBlock Text="What the local model wrote. Expand an entry to see its raw output." Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="NoOutputs" Text="Nothing yet. Summaries, the pulse and the brief appear here once the local model writes them." Style="{StaticResource T.Body2}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ItemsControl x:Name="Outputs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,6" Foreground="{DynamicResource B.Text}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Purpose}" AutomationProperties.AutomationId="{Binding Key, StringFormat=output-{0}}">
                                        <Expander.Header>
                                            <TextBlock FontSize="12.5"><Run Text="{Binding Purpose, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource B.Text3}"/></TextBlock>
                                        </Expander.Header>
                                        <Border Style="{StaticResource CardInner}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Output}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource B.Text2}"/>
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:Card>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="AgentInspector" Visibility="Collapsed" MaxWidth="850" HorizontalAlignment="Stretch" PreviewKeyDown="OnInspectorKey">
            <Button x:Name="BackToAgents" Content="Back to Agents" Style="{StaticResource Btn.Link}" Click="OnBackToAgents" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="agents-detail-back"/>
            <TextBlock x:Name="DetailTitle" Style="{StaticResource T.Title}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailPurpose" Style="{StaticResource T.Body2}" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <c:Card Title="Overview" Icon="clock">
                <StackPanel>
                    <TextBlock x:Name="DetailState" Style="{StaticResource T.CardTitle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="agents-detail-state"/>
                    <TextBlock x:Name="DetailAccess" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DetailSchedule" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DetailTiming" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DetailNotice" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Vis}}"/>
                    <ItemsControl x:Name="RecipeSteps" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="RunBuiltIn" Content="Run now" Style="{StaticResource Btn.Accent}" Click="OnRunBuiltIn" Margin="0,0,8,6" AutomationProperties.AutomationId="agents-detail-run"/>
                        <Button x:Name="ReviewRecipe" Content="Review run" Style="{StaticResource Btn.Accent}" Click="OnReviewRecipe" Margin="0,0,8,6" AutomationProperties.AutomationId="agents-recipe-review"/>
                        <Button x:Name="PauseRecipe" Style="{StaticResource Btn.Standard}" Click="OnPauseRecipe" Margin="0,0,8,6" AutomationProperties.AutomationId="agents-recipe-pause"/>
                        <Button x:Name="CancelRecipeRun" Content="Cancel run" Style="{StaticResource Btn.Standard}" Click="OnCancelRecipeRun" Margin="0,0,8,6" AutomationProperties.AutomationId="agents-recipe-cancel"/>
                        <Button x:Name="EditRecipeLink" Content="Edit in Workbench" Style="{StaticResource Btn.Link}" Click="OnEditInWorkbench" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <c:GroupBorder x:Name="ReviewPanel" Style="{StaticResource CardInner}" Margin="0,6,0,0" Visibility="Collapsed"
                                   AutomationProperties.Name="Review recipe run" AutomationProperties.AutomationId="agents-recipe-approval">
                        <StackPanel>
                            <TextBlock Text="Confirm this run" Style="{StaticResource T.CardTitle}"/>
                            <TextBlock Text="Aqua will run the steps above once. The latest full report in This PC will be replaced. Agents keeps short counts and step outcomes for the last ten runs."
                                       Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button x:Name="DismissReview" Content="Cancel" Click="OnDismissReview" Style="{StaticResource Btn.Standard}" Margin="0,0,8,6"/>
                                <Button x:Name="ConfirmRecipe" Content="Run now" Click="OnConfirmRecipe" Style="{StaticResource Btn.Accent}" Margin="0,0,0,6"
                                        AutomationProperties.AutomationId="agents-recipe-confirm"/>
                            </WrapPanel>
                        </StackPanel>
                    </c:GroupBorder>
                </StackPanel>
            </c:Card>

            <c:Card x:Name="RecentRunsCard" Title="Recent runs" Icon="book" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="DetailEmpty" Text="No runs yet." Style="{StaticResource T.Body2}"/>
                    <ItemsControl x:Name="BuiltInHistory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListBox x:Name="RecipeHistory" SelectionChanged="OnRunSelected" AutomationProperties.Name="Recipe run history"
                             AutomationProperties.AutomationId="agents-recipe-history" Background="{DynamicResource B.Card}" Foreground="{DynamicResource B.Text}"
                             BorderBrush="{DynamicResource B.ControlStroke}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6,5"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RunOutcome" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="agents-recipe-outcome"/>
                    <ItemsControl x:Name="RunSteps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,5,0,0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="CurrentFindings" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="OpenHealthReport" Content="Open latest report in This PC" Style="{StaticResource Btn.Link}" Click="OnOpenHealthReport" Margin="0,0,10,0"/>
                        <Button x:Name="ClearRecipeHistory" Content="Clear recipe history" Style="{StaticResource Btn.Link}" Click="OnClearRecipeHistory"
                                AutomationProperties.AutomationId="agents-recipe-clear"/>
                    </WrapPanel>
                </StackPanel>
            </c:Card>
          </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <c:FeedbackPopup x:Name="AgentsFeedback"/>
    </Grid>
</UserControl>
