<UserControl x:Class="AquaHub.UI.Pages.AskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <UserControl.Resources>
        <!-- Composer switches: compact chips with an icon -->
        <Style x:Key="ModeChip" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="MsgAction" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="ui:UiProps.CornerRadius" Value="7"/>
        </Style>
        <!-- Your question: selectable text you can copy -->
        <Style x:Key="QuestionText" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyText}">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,26,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Chat history ═══ -->
        <c:GroupBorder x:Name="HistoryPanel" Width="262" Margin="0,0,20,0" Style="{StaticResource Card}" Padding="10,12" CornerRadius="14"
                AutomationProperties.AutomationId="ask-history" AutomationProperties.Name="Chat history">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,0,0,8">
                    <TextBlock Text="Chats" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MsgAction}" Click="OnNewChat" ToolTip="New chat" AutomationProperties.AutomationId="ask-history-new">
                            <c:Icon Kind="plus" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource MsgAction}" Click="OnToggleHistory" ToolTip="Hide chats">
                            <c:Icon Kind="chevron-left" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="ChatSearch" Grid.Row="1" ui:UiProps.Placeholder="Search chats" TextChanged="OnChatSearch" Margin="0,0,0,8"
                         ui:UiProps.CornerRadius="8" AutomationProperties.AutomationId="ask-history-search"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChatList" AutomationProperties.Name="Chats">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Overline}" Margin="6,10,0,4"
                                               Visibility="{Binding IsHeader, Converter={StaticResource Vis}}"/>
                                    <Grid x:Name="Row" Visibility="{Binding IsChat, Converter={StaticResource Vis}}" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                                                <MenuItem Header="Rename…" Command="{Binding RenameCommand}"/>
                                                <MenuItem Header="{Binding StarLabel}" Command="{Binding StarCommand}"/>
                                                <MenuItem Header="Copy chat (Markdown)" Command="{Binding CopyCommand}"/>
                                                <MenuItem Header="Save chat as Markdown…" Command="{Binding SaveCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Delete chat" Command="{Binding DeleteCommand}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border x:Name="RowBg" Grid.ColumnSpan="2" CornerRadius="8" Background="Transparent"/>
                                        <Button x:Name="OpenButton" Style="{StaticResource Btn.Row}" Padding="8,6" Command="{Binding OpenCommand}" ToolTip="{Binding Tooltip}"
                                                AutomationProperties.AutomationId="ask-chat" AutomationProperties.Name="{Binding Title}"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource VisNot}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <c:Icon Kind="dot" Width="8" Height="8" Foreground="{DynamicResource B.Accent}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" ToolTip="Still answering"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="176"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource B.Text3}" TextTrimming="CharacterEllipsis" MaxWidth="176"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}"
                                                 Margin="2" AutomationProperties.Name="Chat name" IsVisibleChanged="OnRenameBoxVisible">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0" Opacity="0"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource VisNot}}">
                                            <Button Style="{StaticResource MsgAction}" Width="24" Height="24" Command="{Binding StarCommand}" ToolTip="{Binding StarLabel}"
                                                    AutomationProperties.AutomationId="ask-chat-star">
                                                <Grid>
                                                    <c:Icon Kind="star" Width="12" Height="12" Visibility="{Binding Starred, Converter={StaticResource VisNot}}"/>
                                                    <c:Icon Kind="star-filled" Width="12" Height="12" Foreground="{DynamicResource B.Warn}" Visibility="{Binding Starred, Converter={StaticResource Vis}}"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource MsgAction}" Width="24" Height="24" Command="{Binding DeleteCommand}" ToolTip="Delete chat"
                                                    AutomationProperties.AutomationId="ask-chat-delete">
                                                <c:Icon Kind="trash" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Starred}" Value="True">
                                        <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="HistoryEmpty" Grid.Row="2" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="6,6,6,0" VerticalAlignment="Top"
                           Text="Your chats will appear here." Visibility="Collapsed"/>
                <TextBlock x:Name="RetentionNote" Grid.Row="3" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="6,8,4,0" FontSize="11"/>
            </Grid>
        </c:GroupBorder>

        <Grid Grid.Column="1" MaxWidth="1040">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HistoryToggle" Style="{StaticResource Btn.Icon}" Click="OnToggleHistory" ToolTip="Show chats" Margin="0,0,10,0" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="ask-history-toggle" Visibility="Collapsed">
                    <c:Icon Kind="message" Width="16" Height="16"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PageTitle" Text="Ask Aqua" Style="{StaticResource T.Title}" TextTrimming="CharacterEllipsis"/>
                    <!-- Wraps on a narrow window, so "Turn on local AI" moves to the next line instead of off the edge -->
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock x:Name="Subtitle" Style="{StaticResource T.Body2}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" Margin="0,0,6,0"/>
                        <Button x:Name="TurnOnAi" Style="{StaticResource Btn.Link}" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="OnTurnOnAi" AutomationProperties.AutomationId="ask-turn-on-ai" Content="Turn on local AI"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyChatButton" Style="{StaticResource Btn.Icon}" Click="OnCopyChat" Margin="0,0,2,0" Visibility="Collapsed"
                            AutomationProperties.AutomationId="ask-copy-chat" AutomationProperties.Name="Copy chat"
                            ToolTip="Copy the whole chat as Markdown — your questions, the answers, plans, searches, reasoning and sources (right-click to save it as a file)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy chat (Markdown)" Click="OnCopyChat"/>
                                <MenuItem Header="Save chat as Markdown…" Click="OnSaveChat"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <c:Icon x:Name="CopyChatIcon" Kind="copy" Width="15" Height="15"/>
                            <c:Icon x:Name="CopiedChatIcon" Kind="check" Width="15" Height="15" Foreground="{DynamicResource B.Up}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="StarChatButton" Style="{StaticResource Btn.Icon}" Click="OnStarCurrent" Margin="0,0,6,0" Visibility="Collapsed"
                            AutomationProperties.AutomationId="ask-star-chat" ToolTip="Star this chat (starred chats never expire)">
                        <Grid>
                            <c:Icon x:Name="StarOutline" Kind="star" Width="15" Height="15"/>
                            <c:Icon x:Name="StarFilled" Kind="star-filled" Width="15" Height="15" Foreground="{DynamicResource B.Warn}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NewChatButton" Style="{StaticResource Btn.Standard}" Click="OnNewChat">
                        <StackPanel Orientation="Horizontal"><c:Icon Kind="plus" Width="14" Height="14"/><TextBlock Text="New chat" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource B.Brand}" HorizontalAlignment="Center">
                    <c:Icon Kind="sparkle" Width="30" Height="30" Foreground="White"/>
                </Border>
                <TextBlock Text="What would you like to know?" Style="{StaticResource T.Subtitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                <TextBlock Text="Answers start from the news, social chatter, markets, weather and agenda your agents collected. Turn on Web to look things up, Research for a cited report, Think for harder questions, or Use my PC to find files, see your screen and work with your apps. Teach Aqua new skills in the Workbench. The model runs privately on this PC."
                           Style="{StaticResource T.Body2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <WrapPanel x:Name="Suggestions" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" PreviewMouseWheel="OnScrollerWheel">
                <ItemsControl x:Name="Messages" Margin="0,0,8,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <!-- You -->
                                <StackPanel x:Name="UserPart" HorizontalAlignment="Right" MaxWidth="660" Visibility="{Binding IsUser, Converter={StaticResource Vis}}">
                                    <ItemsControl ItemsSource="{Binding Attachments}" HorizontalAlignment="Right" Margin="0,0,0,6" Visibility="{Binding HasAttachments, Converter={StaticResource Vis}}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Background="{DynamicResource B.Subtle}" Padding="8,5" Margin="6,0,0,4" ToolTip="{Binding Tooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="5" Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}" Margin="0,0,6,0">
                                                            <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background>
                                                        </Border>
                                                        <c:Icon Kind="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center"
                                                                Visibility="{Binding HasThumbnail, Converter={StaticResource VisNot}}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- The question: select and copy any part of it -->
                                    <Border CornerRadius="16,16,4,16" Background="{DynamicResource B.AccentSoft}" Padding="14,10" HorizontalAlignment="Right"
                                            Visibility="{Binding IsEditing, Converter={StaticResource VisNot}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
                                                <MenuItem Header="Edit and ask again" Command="{Binding EditCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <TextBox Style="{StaticResource QuestionText}" Text="{Binding Text, Mode=OneWay}" AutomationProperties.AutomationId="ask-question"
                                                 AutomationProperties.Name="Your question">
                                            <TextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="ApplicationCommands.Copy" Header="Copy selection"/>
                                                    <MenuItem Header="Copy the whole question" Command="{Binding CopyCommand}"/>
                                                    <MenuItem Header="Edit and ask again" Command="{Binding EditCommand}"/>
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                        </TextBox>
                                    </Border>
                                    <!-- Editing in place -->
                                    <Border CornerRadius="14" Background="{DynamicResource B.CardInner}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1" Padding="10"
                                            MinWidth="380" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220"
                                                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ask-edit-box" AutomationProperties.Name="Edit your question"
                                                     IsVisibleChanged="OnEditBoxVisible">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                                                    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveEditCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Style="{StaticResource Btn.Standard}" Padding="12,5" Margin="0,0,6,0" Content="Cancel" Command="{Binding CancelEditCommand}"/>
                                                <Button Style="{StaticResource Btn.Accent}" Padding="12,5" Content="Save and ask" Command="{Binding SaveEditCommand}"
                                                        AutomationProperties.AutomationId="ask-edit-save" ToolTip="Ask this instead (replaces the answers after it) · Ctrl+Enter"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" Margin="0,4,62,0"
                                                   Visibility="{Binding HasMode, Converter={StaticResource Vis}}"/>
                                        <StackPanel x:Name="UserActions" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.35"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource VisNot}}">
                                            <Button Style="{StaticResource MsgAction}" Width="26" Height="26" Command="{Binding CopyCommand}" ToolTip="Copy"
                                                    AutomationProperties.AutomationId="ask-question-copy">
                                                <c:Icon Kind="copy" Width="12" Height="12"/>
                                            </Button>
                                            <Button Style="{StaticResource MsgAction}" Width="26" Height="26" Command="{Binding EditCommand}" ToolTip="Edit and ask again"
                                                    AutomationProperties.AutomationId="ask-question-edit">
                                                <c:Icon Kind="edit" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- Aqua -->
                                <Grid Visibility="{Binding IsUser, Converter={StaticResource VisNot}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource B.Brand}" VerticalAlignment="Top">
                                        <c:Icon Kind="sparkle" Width="14" Height="14" Foreground="White"/>
                                    </Border>
                                    <Border Grid.Column="1" Margin="12,0,24,0" Style="{StaticResource Card}" Padding="16,12" CornerRadius="4,16,16,16">
                                        <StackPanel>
                                            <!-- What Ask did: its plan, searches, pages, files (folds to a summary when a long answer is done) -->
                                            <Expander IsExpanded="{Binding StepsOpen, Mode=TwoWay}" Margin="-6,0,0,6" Visibility="{Binding Steps.Count, Converter={StaticResource Vis}}">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding ActivityLabel}" FontSize="12.5" Foreground="{DynamicResource B.Text2}"/>
                                                </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Steps}" Margin="6,4,0,2" AutomationProperties.Name="Activity">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <c:Icon Kind="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                            <TextBlock x:Name="StepText" Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource B.Text2}"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Text}"/>
                                                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Command="{Binding OpenCommand}"
                                                                    ToolTip="{Binding Url}" AutomationProperties.Name="Open source page"
                                                                    Visibility="{Binding Url, Converter={StaticResource Vis}}">
                                                                <c:Icon Kind="external" Width="11" Height="11"/>
                                                            </Button>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource B.Text3}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </Expander>

                                            <!-- Reasoning (Think) -->
                                            <Expander IsExpanded="{Binding ReasoningOpen, Mode=TwoWay}" Margin="-6,0,0,8" Visibility="{Binding HasReasoning, Converter={StaticResource Vis}}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:Icon Kind="brain" Width="13" Height="13" Foreground="{DynamicResource B.Text2}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ReasoningLabel}" FontSize="12.5" Foreground="{DynamicResource B.Text2}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Border BorderThickness="2,0,0,0" BorderBrush="{DynamicResource B.Divider}" Padding="10,2,0,2" Margin="12,4,0,0">
                                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Reasoning, Mode=OneWay}" FontSize="12.5" MaxHeight="260"
                                                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reasoning"/>
                                                </Border>
                                            </Expander>

                                            <!-- Approval request -->
                                            <c:GroupBorder Margin="0,0,0,10" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource B.Accent}"
                                                    Background="{DynamicResource B.AccentSoft}" Visibility="{Binding HasApproval, Converter={StaticResource Vis}}"
                                                    AutomationProperties.AutomationId="ask-approval" AutomationProperties.Name="Approval needed">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:Icon Kind="{Binding Approval.Icon}" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Approval.Title, StringFormat='Aqua would like to: {0}'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Approval.Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="23,4,0,8"/>
                                                    <TextBlock Text="This needs your OK each time." Style="{StaticResource T.Caption}" FontStyle="Italic" Margin="23,-4,0,8"
                                                               Visibility="{Binding Approval.CanAllowForChat, Converter={StaticResource VisNot}}"/>
                                                    <WrapPanel Margin="21,0,0,0">
                                                        <Button Style="{StaticResource Btn.Accent}" Padding="14,5" Margin="0,0,6,0" Content="Allow" Command="{Binding Approval.AllowCommand}"
                                                                AutomationProperties.AutomationId="ask-approve"/>
                                                        <Button Style="{StaticResource Btn.Standard}" Padding="12,5" Margin="0,0,6,0" Content="Allow for this chat" Command="{Binding Approval.AllowForChatCommand}"
                                                                Visibility="{Binding Approval.CanAllowForChat, Converter={StaticResource Vis}}"/>
                                                        <Button Style="{StaticResource Btn.Standard}" Padding="12,5" Content="Don't allow" Command="{Binding Approval.DenyCommand}"
                                                                AutomationProperties.AutomationId="ask-deny"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </c:GroupBorder>

                                            <!-- The answer: selectable, with right-click Ask about this / Search the web -->
                                            <c:MarkdownView Markdown="{Binding Text}" Citations="{Binding Citations}" FontSize="14"
                                                            Visibility="{Binding HasText, Converter={StaticResource Vis}}" AutomationProperties.Name="Answer"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsThinking, Converter={StaticResource Vis}}">
                                                <c:Shimmer Width="140" Height="10" CornerRadius="5"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}" FontStyle="Italic" Margin="0,6,0,0"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource Vis}}"/>

                                            <ItemsControl ItemsSource="{Binding Citations}" Margin="0,10,0,0" Visibility="{Binding HasCitations, Converter={StaticResource Vis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button x:Name="Chip" Style="{StaticResource Btn.Standard}" Padding="8,3" FontSize="11.5" Margin="0,0,6,6" ui:UiProps.CornerRadius="10"
                                                                Click="OnCitation" Tag="{Binding}" ToolTip="{Binding Title}" AutomationProperties.AutomationId="ask-citation">
                                                            <TextBlock>
                                                                <Run Text="{Binding Number, Mode=OneWay, StringFormat='[{0}] '}" Foreground="{DynamicResource B.AccentText}"/><Run Text="{Binding Source, Mode=OneWay}"/><Run x:Name="ChipNote" Text="" Foreground="{DynamicResource B.Text3}"/>
                                                            </TextBlock>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <!-- Only the search result's title and snippet were seen (the page wasn't read). -->
                                                            <DataTrigger Binding="{Binding Kind}" Value="result">
                                                                <Setter TargetName="ChipNote" Property="Text" Value=" · snippet"/>
                                                                <Setter TargetName="Chip" Property="ToolTip" Value="{Binding Title, StringFormat='{}{0} — only its search snippet was used; the page wasn’t read'}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="file">
                                                                <Setter TargetName="ChipNote" Property="Text" Value="{Binding Title, StringFormat=' · {0}'}"/>
                                                                <Setter TargetName="Chip" Property="ToolTip" Value="Open it (programs are only shown in their folder)"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Footer}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Visibility="{Binding Footer, Converter={StaticResource Vis}}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsDone, Converter={StaticResource Vis}}">
                                                    <Button Style="{StaticResource MsgAction}" Command="{Binding CopyCommand}" ToolTip="Copy the answer">
                                                        <c:Icon Kind="copy" Width="13" Height="13"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MsgAction}" Command="{Binding ReadAloudCommand}" ToolTip="{Binding ReadAloudTip}"
                                                            AutomationProperties.AutomationId="ask-read-aloud">
                                                        <Grid>
                                                            <c:Icon Kind="volume" Width="13" Height="13" Visibility="{Binding IsSpeaking, Converter={StaticResource VisNot}}"/>
                                                            <c:Icon Kind="pause" Width="13" Height="13" Visibility="{Binding IsSpeaking, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource MsgAction}" Command="{Binding RetryCommand}" ToolTip="Ask again" Visibility="{Binding Question, Converter={StaticResource Vis}}">
                                                        <c:Icon Kind="refresh" Width="13" Height="13"/>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Link}" Command="{Binding DeeperCommand}" FontSize="12" Padding="6,2" Visibility="{Binding Question, Converter={StaticResource Vis}}"
                                                            ToolTip="Research this properly: several searches, the best pages read, a cited report">
                                                        <StackPanel Orientation="Horizontal"><c:Icon Kind="research" Width="12" Height="12"/><TextBlock Text="Dig deeper" Margin="5,0,0,0"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Btn.Link}" Command="{Binding UndoMemoryCommand}" FontSize="12" Padding="6,2" Content="Undo"
                                                            Visibility="{Binding HasMemoryActions, Converter={StaticResource Vis}}" AutomationProperties.AutomationId="ask-memory-undo"/>
                                                    <Button Style="{StaticResource Btn.Link}" Command="{Binding AnswerInsteadCommand}" FontSize="12" Padding="6,2" Content="Answer it instead"
                                                            Visibility="{Binding HasMemoryActions, Converter={StaticResource Vis}}" AutomationProperties.AutomationId="ask-memory-answer"
                                                            ToolTip="It wasn't something to remember: answer it as a question"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="UserPart" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="UserActions" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Composer -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,10,0,0" CornerRadius="14">
                <StackPanel>
                    <!-- Attachments waiting to be sent -->
                    <ItemsControl x:Name="PendingList" Margin="6,4,6,2" Visibility="Collapsed" AutomationProperties.Name="Attachments">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="{DynamicResource B.Subtle}" Padding="6,4,4,4" Margin="0,0,6,6" ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,6,0" Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}">
                                            <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background>
                                        </Border>
                                        <c:Icon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center" Margin="2,0,6,0"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource VisNot}}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{DynamicResource B.Text3}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" ToolTip="Remove">
                                            <c:Icon Kind="close" Width="10" Height="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Input" Background="Transparent" BorderBrush="Transparent" FontSize="14.5" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="160" VerticalScrollBarVisibility="Auto" AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
                                 ui:UiProps.Placeholder="Ask anything…" ToolTip="Enter sends · Shift+Enter adds a line · attach files or a screenshot, speak, or switch on Web, Research or Use my PC below"
                                 PreviewKeyDown="OnInputKey" TextChanged="OnInputChanged">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Cut"/>
                                    <MenuItem Command="ApplicationCommands.Copy"/>
                                    <MenuItem Command="ApplicationCommands.Paste"/>
                                    <MenuItem Command="ApplicationCommands.SelectAll"/>
                                    <Separator/>
                                    <MenuItem Header="Edit my last question" Click="OnEditLast"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,2,2">
                            <Button x:Name="MicButton" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Click="OnMic" Margin="0,0,6,0"
                                    ToolTip="Speak your question" AutomationProperties.AutomationId="ask-mic" ui:UiProps.CornerRadius="10">
                                <c:Icon Kind="mic" Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="StopButton" Style="{StaticResource Btn.Standard}" Click="OnStop" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="Stop generating">
                                <c:Icon Kind="pause" Width="14" Height="14"/>
                            </Button>
                            <Button x:Name="SendButton" Style="{StaticResource Btn.Accent}" Click="OnSend" Width="42" Height="36" Padding="0" ui:UiProps.CornerRadius="10" ToolTip="Send">
                                <c:Icon Kind="send" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Tools and switches -->
                    <Grid Margin="4,4,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button x:Name="AttachButton" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Click="OnAttach" ToolTip="Attach files (documents, spreadsheets, PDFs, images)"
                                    AutomationProperties.AutomationId="ask-attach">
                                <c:Icon Kind="paperclip" Width="15" Height="15"/>
                            </Button>
                            <Button x:Name="ScreenshotButton" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Click="OnScreenshotMenu" ToolTip="Add a screenshot"
                                    AutomationProperties.AutomationId="ask-screenshot" Margin="0,0,8,0">
                                <c:Icon Kind="screenshot" Width="15" Height="15"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Capture the screen Aqua is on" Click="OnCaptureScreen"/>
                                        <MenuItem Header="Snip an area…" Click="OnSnip"/>
                                        <MenuItem x:Name="PasteImageItem" Header="Paste image from clipboard" Click="OnPasteImage"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource B.Divider}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModelPicker" Width="170" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"
                                      SelectionChanged="OnModelPicked" AutomationProperties.Name="Model" AutomationProperties.AutomationId="ask-model"
                                      ToolTip="The model that answers here. Think and Research are remembered for each model; a model that isn't loaded yet takes a few seconds the first time."/>
                            <ToggleButton x:Name="WebToggle" Style="{StaticResource ModeChip}" Checked="OnMode" Unchecked="OnMode" AutomationProperties.Name="Web"
                                          ToolTip="Web: Aqua may search the internet and read pages when your feeds don't have the answer">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="globe" Width="12" Height="12"/><TextBlock Text="Web" Margin="5,0,0,0"/></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ResearchToggle" Style="{StaticResource ModeChip}" Checked="OnMode" Unchecked="OnMode" AutomationProperties.Name="Research"
                                          ToolTip="Research: plans several searches, reads the best pages and writes a cited report (takes a minute or two)">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="research" Width="12" Height="12"/><TextBlock Text="Research" Margin="5,0,0,0"/></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ThinkToggle" Style="{StaticResource ModeChip}" Checked="OnMode" Unchecked="OnMode" AutomationProperties.Name="Think"
                                          ToolTip="Think: the model reasons step by step before answering — slower, better for tricky questions">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="brain" Width="12" Height="12"/><TextBlock Text="Think" Margin="5,0,0,0"/></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ComputerToggle" Style="{StaticResource ModeChip}" Checked="OnMode" Unchecked="OnMode" AutomationProperties.Name="Use my PC"
                                          ToolTip="Use my PC: Aqua may find and read files in the folders you allowed, look at your screen, and — with your OK each time — open things, work with app windows or control media">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="computer" Width="12" Height="12"/><TextBlock Text="Use my PC" Margin="5,0,0,0"/></StackPanel>
                            </ToggleButton>
                            <TextBlock x:Name="ModeHint" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                            <Button x:Name="TidyUndo" Style="{StaticResource Btn.Link}" Content="Undo" Visibility="Collapsed" Click="OnUndoTidy" VerticalAlignment="Center"
                                    Margin="6,0,0,0" FontSize="12" AutomationProperties.AutomationId="ask-tidy-undo" ToolTip="Put back the words exactly as the recognizer heard them"/>
                        </WrapPanel>
                        <!-- Context meter -->
                        <Button x:Name="ContextButton" Grid.Column="1" Style="{StaticResource Btn.Subtle}" Padding="8,4" Click="OnContext" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ask-context" ToolTip="How much of the model's context this chat uses — click for settings">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="54" Height="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border CornerRadius="2.5" Background="{DynamicResource B.Track}"/>
                                    <Border x:Name="ContextFill" CornerRadius="2.5" Background="{DynamicResource B.Accent}" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="ContextLabel" FontSize="11.5" Foreground="{DynamicResource B.Text3}" Text="Context"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="ContextPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=ContextButton}" Placement="Top" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-230">
                            <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="330" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Context" Style="{StaticResource T.CardTitle}"/>
                                    <TextBlock x:Name="ContextDetail" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <TextBlock Text="Context window" FontSize="12.5" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ContextWindowCombo" SelectionChanged="OnContextWindowChanged" AutomationProperties.Name="Context window">
                                        <ComboBoxItem Content="Automatic (grows when needed)" Tag="0"/>
                                        <ComboBoxItem Content="8K tokens" Tag="8192"/>
                                        <ComboBoxItem Content="16K tokens" Tag="16384"/>
                                        <ComboBoxItem Content="32K tokens" Tag="32768"/>
                                        <ComboBoxItem Content="64K tokens" Tag="65536"/>
                                        <ComboBoxItem Content="128K tokens" Tag="131072"/>
                                    </ComboBox>
                                    <TextBlock Text="Earlier messages sent with each question" FontSize="12.5" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="HistoryCombo" SelectionChanged="OnHistoryLengthChanged" AutomationProperties.Name="Earlier messages sent">
                                        <ComboBoxItem Content="The last 4" Tag="4"/>
                                        <ComboBoxItem Content="The last 10" Tag="10"/>
                                        <ComboBoxItem Content="The last 20" Tag="20"/>
                                        <ComboBoxItem Content="The last 40" Tag="40"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,10,0,6"
                                               Text="A bigger window keeps more of the chat and the material Aqua found, but uses more graphics memory and is slower; changing it reloads the model. When a chat outgrows a fixed window, the oldest messages are left out."/>
                                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Padding="0,2" Content="Start a new chat to clear it" Click="OnNewChat"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- While dictating: how loud you are, and with Windows' recognizers a pointer to Whisper -->
                    <c:GroupGrid x:Name="VoiceBar" Margin="10,0,4,2" Visibility="Collapsed" AutomationProperties.AutomationId="ask-voice-bar" AutomationProperties.Name="Dictation">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:GroupGrid x:Name="VoiceMeter" Width="54" Height="5" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Microphone level">
                            <Border CornerRadius="2.5" Background="{DynamicResource B.Track}"/>
                            <Border x:Name="VoiceMeterFill" CornerRadius="2.5" Background="{DynamicResource B.Accent}" HorizontalAlignment="Left" Width="0"/>
                        </c:GroupGrid>
                        <TextBlock x:Name="VoiceTip" Grid.Column="1" Style="{StaticResource T.Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ask-voice-tip"/>
                        <StackPanel x:Name="WhisperTipLinks" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Link}" FontSize="12" Content="Set up Whisper" Click="OnWhisperSetup"
                                    AutomationProperties.AutomationId="ask-whisper-setup" ToolTip="Settings › Ask Aqua › Voice"/>
                            <Button Style="{StaticResource Btn.Link}" FontSize="12" Content="Hide" Click="OnHideWhisperTip" Foreground="{DynamicResource B.Text3}"
                                    AutomationProperties.AutomationId="ask-whisper-tip-hide" ToolTip="Don't suggest Whisper again (Settings › Ask Aqua › Voice)"/>
                        </StackPanel>
                    </c:GroupGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
