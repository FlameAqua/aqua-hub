<UserControl x:Class="AquaHub.UI.Pages.SocialPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <Grid Margin="32,26,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,12,16">
            <StackPanel>
                <TextBlock Text="Social pulse" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource T.Body2}" Margin="0,4,0,0" Text="What people around you are talking about — so you don't have to scroll."/>
            </StackPanel>
            <Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnConfigure">
                <StackPanel Orientation="Horizontal"><c:Icon Kind="settings" Width="14" Height="14"/><TextBlock Text="Sources" Margin="8,0,0,0"/></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="4*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Topics (AI) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
                <StackPanel>
                    <c:Card Title="The pulse" Icon="fire" Badge="{Binding Badge}" Subtitle="{Binding Meta}" Background="{DynamicResource B.Hero}" BorderBrush="{DynamicResource B.AccentSoft}">
                        <TextBlock Text="{Binding Overview}" FontSize="15.5" LineHeight="24" TextWrapping="Wrap"/>
                    </c:Card>
                    <ItemsControl ItemsSource="{Binding Topics}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource B.Subtle}">
                                                    <c:Icon Kind="fire" Width="16" Height="16" Foreground="{Binding SentimentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Pill}" Background="{DynamicResource B.Subtle}" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding SentimentBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Sentiment}" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource B.Text2}"/>
                                                    </StackPanel>
                                                </Border>
                                                <c:Bar Value="{Binding HeatValue}" Width="60" Height="5" Fill="{Binding SentimentBrush}" Track="{DynamicResource B.Track}" ToolTip="How much it's being discussed"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.Text2}" Margin="0,10,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Posts}" ItemTemplate="{StaticResource Tpl.PostRow}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:Shimmer Height="200" Margin="0,12,0,0" Visibility="{Binding HasTopics, Converter={StaticResource VisNot}}"/>
                    <c:Card Title="Trending globally" Icon="globe" Subtitle="Bluesky-wide, not local — for context only" Margin="0,4,0,0"
                            Visibility="{Binding HasTrending, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Trending}" ItemTemplate="{StaticResource Tpl.PostRow}"/>
                    </c:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Raw feed -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,16,18,8">
                        <TextBlock Text="Latest posts" Style="{StaticResource T.CardTitle}"/>
                        <WrapPanel x:Name="Platforms" Margin="0,10,0,0"/>
                    </StackPanel>
                    <!-- Nothing to show: say why, and offer the fix -->
                    <c:GroupBorder x:Name="FeedEmpty" DockPanel.Dock="Top" Margin="18,28,18,24" HorizontalAlignment="Center" MaxWidth="340" Visibility="Collapsed"
                                   AutomationProperties.AutomationId="social-feed-empty" AutomationProperties.Name="{Binding Text, ElementName=FeedEmptyTitle}">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource B.Subtle}" HorizontalAlignment="Center">
                                <c:Icon x:Name="FeedEmptyIcon" Kind="social" Width="20" Height="20" Foreground="{DynamicResource B.Text2}"/>
                            </Border>
                            <TextBlock x:Name="FeedEmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4"/>
                            <TextBlock x:Name="FeedEmptyBody" Style="{StaticResource T.Body2}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="FeedEmptyAction" Style="{StaticResource Btn.Accent}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14,6" Click="OnFeedEmptyAction"
                                    AutomationProperties.AutomationId="social-feed-empty-action"/>
                        </StackPanel>
                    </c:GroupBorder>
                    <ListBox x:Name="Feed" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource Tpl.PostRow}" Padding="18,0,18,12"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,0,0,4"/></ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
