<UserControl x:Class="AquaHub.UI.Pages.WorkbenchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <UserControl.Resources>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
            <Setter Property="Background" Value="{DynamicResource B.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="WorkbenchTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,24" MaxWidth="1040">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Workbench" Style="{StaticResource T.Title}"/>
            <TextBlock Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Teach Aqua new skills and things to remember. Describe what you want in your own words and Aqua drafts a skill from its own tools — no code runs, and anything that acts on your PC still asks you first."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
            <RadioButton x:Name="SkillsTab" Style="{StaticResource Tab}" IsChecked="True" Checked="OnTab" AutomationProperties.AutomationId="wb-tab-skills">
                <StackPanel Orientation="Horizontal"><c:Icon Kind="wand" Width="13" Height="13"/><TextBlock x:Name="SkillsTabText" Text="Skills" Margin="6,0,0,0"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="MemoryTab" Style="{StaticResource Tab}" Checked="OnTab" AutomationProperties.AutomationId="wb-tab-memory">
                <StackPanel Orientation="Horizontal"><c:Icon Kind="brain" Width="13" Height="13"/><TextBlock x:Name="MemoryTabText" Text="Memory" Margin="6,0,0,0"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="AbilitiesTab" Style="{StaticResource Tab}" Checked="OnTab" AutomationProperties.AutomationId="wb-tab-abilities">
                <StackPanel Orientation="Horizontal"><c:Icon Kind="sparkle" Width="13" Height="13"/><TextBlock Text="What Aqua can do" Margin="6,0,0,0"/></StackPanel>
            </RadioButton>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,8">
                <!-- ═══ Skills ═══ -->
                <StackPanel x:Name="SkillsPanel">
                    <!-- Teach -->
                    <Border x:Name="TeachCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Teach Aqua a skill" Style="{StaticResource T.CardTitle}"/>
                            <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Text="Say what it should do and when. Aqua turns it into instructions and, where it helps, fixed steps using its own tools — you check it, try it and save it."/>
                            <TextBox x:Name="TeachInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                     ui:UiProps.Placeholder="e.g. When I say “focus time”, pause the music, turn on do not disturb and open my to-do list"
                                     AutomationProperties.AutomationId="wb-teach"/>
                            <WrapPanel x:Name="Examples" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DraftButton" Style="{StaticResource Btn.Accent}" Click="OnDraft" AutomationProperties.AutomationId="wb-draft">
                                    <StackPanel Orientation="Horizontal"><c:Icon Kind="wand" Width="14" Height="14"/><TextBlock Text="Draft the skill" Margin="8,0,0,0"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Standard}" Margin="8,0,0,0" Content="Write it myself" Click="OnScratch" AutomationProperties.AutomationId="wb-scratch"/>
                                <TextBlock x:Name="TeachStatus" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Draft / edit -->
                    <Border x:Name="Editor" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14" Visibility="Collapsed" BorderBrush="{DynamicResource B.Accent}"
                            AutomationProperties.AutomationId="wb-editor">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="EditorTitle" Text="New skill" Style="{StaticResource T.CardTitle}"/>
                                <TextBlock x:Name="EditorHint" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SkillName" AutomationProperties.AutomationId="wb-skill-name" ui:UiProps.Placeholder="e.g. Focus time"/>
                            <TextBlock Text="Use it when" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SkillWhen" AutomationProperties.AutomationId="wb-skill-when" ui:UiProps.Placeholder="e.g. The user wants to concentrate or says “focus time”"/>
                            <TextBlock Text="Things you might say (one per line)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SkillTriggers" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.AutomationId="wb-skill-triggers"/>
                            <TextBlock Text="What Aqua should do" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SkillInstructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="wb-skill-instructions"/>
                            <TextBlock Text="Fixed steps (run in order, each with its usual permissions)" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl x:Name="StepsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource B.Subtle}" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Command="{Binding RemoveCommand}" ToolTip="Remove this step">
                                                <c:Icon Kind="trash" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSteps" Style="{StaticResource T.Caption}" Text="No fixed steps — Aqua follows the instructions and uses whichever tools it needs." TextWrapping="Wrap"/>
                            <TextBlock x:Name="EditorNotes" Style="{StaticResource T.Caption}" Foreground="{DynamicResource B.Warn}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                            <Border Style="{StaticResource CardInner}" Padding="12,10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Not quite right? Tell Aqua what to change" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text2}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FeedbackInput" ui:UiProps.Placeholder="e.g. Also mute the volume, and don't open the to-do list on weekends"
                                                 AutomationProperties.AutomationId="wb-feedback"/>
                                        <Button x:Name="ImproveButton" Grid.Column="1" Style="{StaticResource Btn.Standard}" Margin="8,0,0,0" Click="OnImprove"
                                                AutomationProperties.AutomationId="wb-improve">
                                            <StackPanel Orientation="Horizontal"><c:Icon Kind="wand" Width="13" Height="13"/><TextBlock Text="Improve" Margin="6,0,0,0"/></StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn.Accent}" Content="Save skill" Click="OnSaveSkill" AutomationProperties.AutomationId="wb-save"/>
                                <Button Style="{StaticResource Btn.Standard}" Margin="8,0,0,0" Click="OnTryDraft" AutomationProperties.AutomationId="wb-try"
                                        ToolTip="Saves it and asks it in a new chat">
                                    <StackPanel Orientation="Horizontal"><c:Icon Kind="play" Width="12" Height="12"/><TextBlock Text="Save and try it" Margin="6,0,0,0"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Subtle}" Margin="8,0,0,0" Content="Discard" Click="OnDiscard" AutomationProperties.AutomationId="wb-discard"/>
                                <TextBlock x:Name="EditorStatus" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Your skills -->
                    <Grid Margin="4,6,0,8">
                        <TextBlock x:Name="SkillsHeader" Text="YOUR SKILLS" Style="{StaticResource T.Overline}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="UseSkills" Style="{StaticResource Switch}" Content="Use my skills in Ask" Click="OnUseSkills"
                                      AutomationProperties.Name="Use my skills in Ask"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NoSkills" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="4,0,0,0"
                               Text="No skills yet. Describe one above — or try an example."/>
                    <ItemsControl x:Name="SkillsList" AutomationProperties.Name="Your skills">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" VerticalAlignment="Top" Margin="0,2,12,0">
                                            <c:Icon Kind="wand" Width="16" Height="16" Foreground="{DynamicResource B.AccentText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Triggers}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"
                                                       Visibility="{Binding HasTriggers, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}"
                                                      ToolTip="On: Ask uses this skill when a request fits"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding TryCommand}" ToolTip="Try it in a new chat">
                                                    <c:Icon Kind="play" Width="13" Height="13"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding EditCommand}" ToolTip="Edit">
                                                    <c:Icon Kind="edit" Width="13" Height="13"/>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding DeleteCommand}" ToolTip="Delete this skill">
                                                    <c:Icon Kind="trash" Width="13" Height="13"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══ Memory ═══ -->
                <StackPanel x:Name="MemoryPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Something Aqua should remember" Style="{StaticResource T.CardTitle}"/>
                            <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Text="Facts and preferences Aqua keeps in mind in every answer — where you keep things, how you like answers, names it should know. You can also say “remember that …” in Ask. Kept only on this PC."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MemoryInput" ui:UiProps.Placeholder="e.g. My logos and brand images are in Pictures\Brand" KeyDown="OnMemoryKey"
                                         AutomationProperties.AutomationId="wb-memory-input"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Accent}" Margin="8,0,0,0" Content="Remember" Click="OnRemember"
                                        AutomationProperties.AutomationId="wb-remember"/>
                            </Grid>
                            <CheckBox x:Name="UseMemory" Style="{StaticResource Switch}" Content="Use what Aqua remembers in answers" Margin="0,12,0,0" Click="OnUseMemory"
                                      AutomationProperties.Name="Use what Aqua remembers in answers"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoMemories" Style="{StaticResource T.Body2}" Margin="4,0,0,0" Text="Nothing yet."/>
                    <ItemsControl x:Name="MemoryList" AutomationProperties.Name="What Aqua remembers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource VisNot}}">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}"
                                                 AutomationProperties.Name="Edit memory">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding EditCommand}" ToolTip="Edit"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource VisNot}}">
                                                <c:Icon Kind="edit" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding SaveCommand}" ToolTip="Save"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                                <c:Icon Kind="check" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" Width="30" Height="30" Command="{Binding DeleteCommand}" ToolTip="Forget this">
                                                <c:Icon Kind="trash" Width="13" Height="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══ What Aqua can do ═══ -->
                <StackPanel x:Name="AbilitiesPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="4,0,0,12"
                               Text="Everything Ask can use, and what each needs. Skills are built from these; the switches under the Ask box (Web, Use my PC) and Settings › Ask Aqua decide what's available."/>
                    <ItemsControl x:Name="AbilityGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.CardTitle}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="23,2,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Tools}" Margin="23,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <c:Icon Kind="{Binding Icon}" Width="13" Height="13" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontSize="13.5"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Id, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{DynamicResource B.Text3}" FontSize="11.5"/></TextBlock>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource B.Subtle}" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource B.Text2}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Btn.Standard}" HorizontalAlignment="Left" Content="Open Settings › Ask Aqua" Click="OnAskSettings" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
