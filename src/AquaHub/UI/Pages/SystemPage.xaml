<UserControl x:Class="AquaHub.UI.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <UserControl.Resources>
        <!-- A small icon button in a card's header that opens the matching Windows tool -->
        <Style x:Key="ToolLink" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <DataTemplate x:Key="FindingTemplate">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="13.5" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Area, Mode=OneWay}" Foreground="{DynamicResource B.Text3}" FontSize="12"/></TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Fix}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasFix, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Standard}" Padding="10,4" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Top"
                        Content="{Binding ToolName}" Tag="{Binding ToolId}" Click="OnTool" Visibility="{Binding HasTool, Converter={StaticResource Vis}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,36" MaxWidth="1560">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="This PC" Style="{StaticResource T.Title}"/>
                    <TextBlock Text="{Binding Machine}" Style="{StaticResource T.Body2}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}" Foreground="{DynamicResource B.Accent}" Margin="0,4,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="system-status" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Btn.Standard}" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnTool" Tag="taskmgr"
                        ToolTip="What's running and what it uses; end a stuck app" AutomationProperties.AutomationId="system-taskmgr">
                    <StackPanel Orientation="Horizontal"><c:Icon Kind="bolt" Width="14" Height="14"/><TextBlock Text="Task Manager" Margin="8,0,0,0"/></StackPanel>
                </Button>
            </Grid>

            <c:FlowGrid MaxColumns="4" MinColumnWidth="250" Gap="16">
                <c:Card Title="Processor" Icon="system" Subtitle="{Binding CpuSub}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource ToolLink}" Click="OnTool" Tag="resmon" ToolTip="Resource Monitor: which process uses the processor, disk and network" AutomationProperties.Name="Open Resource Monitor">
                            <c:Icon Kind="external" Width="12" Height="12"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <c:RingGauge AutomationProperties.Name="Processor load" Value="{Binding Cpu}" ValueBrush="{Binding CpuBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="120" Height="120" Thickness="10"/>
                        <c:Sparkline Values="{Binding CpuHistory}" Stroke="{DynamicResource B.Accent}" Height="40" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </c:Card>
                <c:Card Title="Memory" Icon="memory" Subtitle="{Binding RamSub}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource ToolLink}" Click="OnTool" Tag="taskmgr" ToolTip="Task Manager: what uses the memory" AutomationProperties.Name="Open Task Manager">
                            <c:Icon Kind="external" Width="12" Height="12"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <c:RingGauge AutomationProperties.Name="Memory in use" Value="{Binding Ram}" ValueBrush="{Binding RamBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="120" Height="120" Thickness="10"/>
                        <c:Sparkline Values="{Binding RamHistory}" Stroke="{DynamicResource B.Info}" Height="40" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </c:Card>
                <c:Card Title="Graphics" Icon="gpu" Subtitle="{Binding GpuSub}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource ToolLink}" Click="OnGraphicsSettings" ToolTip="Graphics settings: which GPU each app uses" AutomationProperties.Name="Open graphics settings">
                            <c:Icon Kind="external" Width="12" Height="12"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <c:RingGauge AutomationProperties.Name="Graphics load" Value="{Binding Gpu}" ValueBrush="{Binding GpuBrush}" TrackBrush="{DynamicResource B.Track}" TextBrush="{DynamicResource B.Text}" Width="120" Height="120" Thickness="10"/>
                        <Grid Margin="0,14,0,4">
                            <TextBlock Text="VRAM" Style="{StaticResource T.Caption}"/>
                            <TextBlock Text="{Binding VramText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <c:Bar Value="{Binding VramValue}" Fill="{DynamicResource B.Accent}" Track="{DynamicResource B.Track}" Height="6"/>
                        <c:Sparkline Values="{Binding GpuHistory}" Stroke="{DynamicResource B.Up}" Height="28" Margin="0,10,0,0"/>
                    </StackPanel>
                </c:Card>
                <c:Card Title="Network" Icon="network" Subtitle="{Binding Uptime}">
                    <c:Card.HeaderAction>
                        <Button Style="{StaticResource ToolLink}" Click="OnTool" Tag="network" ToolTip="Network status: connection, data usage and network reset" AutomationProperties.Name="Open network status">
                            <c:Icon Kind="external" Width="12" Height="12"/>
                        </Button>
                    </c:Card.HeaderAction>
                    <StackPanel>
                        <TextBlock Text="{Binding NetName}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <TextBlock Text="Download" Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="{Binding Down}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <c:Sparkline Values="{Binding DownHistory}" Stroke="{DynamicResource B.Accent}" Height="36" Margin="0,6,0,12"/>
                        <TextBlock Text="Upload" Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="{Binding Up}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <c:Sparkline Values="{Binding UpHistory}" Stroke="{DynamicResource B.Info}" Height="36" Margin="0,6,0,0"/>
                    </StackPanel>
                </c:Card>
            </c:FlowGrid>

            <!-- Health check: Windows' own readings, the findings, and the local model's summary -->
            <c:Card Title="Health check" Icon="pulse" Subtitle="{Binding HealthSub}" Margin="0,16,0,0" AutomationProperties.AutomationId="system-health">
                <c:Card.HeaderAction>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasHealth, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource Btn.Link}" Content="Copy report" Click="OnCopyHealth" FontSize="12.5" Margin="0,0,8,0" AutomationProperties.AutomationId="system-health-copy"/>
                        <Button Style="{StaticResource Btn.Link}" Content="Ask Aqua about it" Click="OnAskHealth" FontSize="12.5" AutomationProperties.AutomationId="system-health-ask"/>
                    </StackPanel>
                </c:Card.HeaderAction>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HealthVerdict}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding HealthBrush}" Visibility="{Binding HasHealth, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource T.Body2}" TextWrapping="Wrap" Visibility="{Binding HasHealth, Converter={StaticResource VisNot}}"
                                       Text="Looks at drive space and drive health, Windows Update, crashes and blue screens, antivirus, devices, battery wear, startup apps and clutter — reading only, nothing is changed. Takes about ten seconds; then the local model sums it up."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HealthRunning, Converter={StaticResource Vis}}">
                                <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HealthStep}" Style="{StaticResource T.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Accent}" Click="OnHealthCheck" IsEnabled="{Binding HealthIdle}" Margin="16,0,0,0" VerticalAlignment="Top"
                                AutomationProperties.AutomationId="system-health-run">
                            <StackPanel Orientation="Horizontal"><c:Icon Kind="pulse" Width="14" Height="14"/><TextBlock Text="{Binding HealthButton}" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasSummary, Converter={StaticResource Vis}}"
                               AutomationProperties.AutomationId="system-health-summary"/>
                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" AutomationProperties.AutomationId="system-health-findings"/>
                    <Expander Header="{Binding PassedHeader}" Margin="0,12,0,0" FontSize="13" Visibility="{Binding HasPassed, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Passed}" ItemTemplate="{StaticResource FindingTemplate}" Margin="0,0,0,4"/>
                    </Expander>
                    <TextBlock Text="{Binding NotChecked}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasNotChecked, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </c:Card>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <c:Card Title="Top processes" Icon="bolt" Subtitle="grouped by app · select one for more">
                        <c:Card.HeaderAction>
                            <Button Style="{StaticResource Btn.Link}" Content="{Binding MoreLabel}" Click="OnMoreProcesses" FontSize="12.5" AutomationProperties.AutomationId="procs-more"/>
                        </c:Card.HeaderAction>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App" Style="{StaticResource T.Caption}"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Base}" Padding="4,1" Margin="0,0,-4,0" HorizontalAlignment="Right" Click="OnSortCpu"
                                        AutomationProperties.AutomationId="procs-sort-cpu" AutomationProperties.Name="Sort by CPU" ToolTip="Sort by processor use">
                                    <TextBlock Text="{Binding CpuHeader}" Style="{StaticResource T.Caption}"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Base}" Padding="4,1" Margin="0,0,-4,0" HorizontalAlignment="Right" Click="OnSortMemory"
                                        AutomationProperties.AutomationId="procs-sort-memory" AutomationProperties.Name="Sort by memory"
                                        ToolTip="Sort by memory — private working set, the figure Task Manager shows">
                                    <TextBlock Text="{Binding MemoryHeader}" Style="{StaticResource T.Caption}"/>
                                </Button>
                            </Grid>
                            <!-- The list holds still while the pointer is on it, so a row doesn't move away as you click it. -->
                            <ItemsControl x:Name="ProcessList" ItemsSource="{Binding Processes}" AutomationProperties.AutomationId="procs-list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Btn.Base}" Padding="6,5" Margin="-6,0" HorizontalContentAlignment="Stretch" Background="{Binding RowBrush}"
                                                Tag="{Binding Name}" PreviewMouseLeftButtonDown="OnProcessPressed" Click="OnProcessClicked" FontSize="13"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="Details and actions">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Width="80">
                                                    <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right"/>
                                                    <c:Bar Value="{Binding CpuValue}" Fill="{DynamicResource B.Accent}" Track="{DynamicResource B.Track}" Height="3" Margin="0,3,0,0" ToolTip="Share of the whole processor (full bar = 25%)"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding MemText}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The selected app: what it is and what you can do -->
                            <Border Style="{StaticResource CardInner}" Margin="0,10,0,0" Visibility="{Binding HasSelected, Converter={StaticResource Vis}}" AutomationProperties.AutomationId="procs-detail">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding SelTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,30,0"/>
                                        <Button Style="{StaticResource Btn.Icon}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseProcess" ToolTip="Close" AutomationProperties.Name="Close details">
                                            <c:Icon Kind="close" Width="10" Height="10"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelInfo}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding SelPath, Mode=OneWay}" FontSize="11.5" Margin="0,4,0,0" Visibility="{Binding SelHasPath, Converter={StaticResource Vis}}"
                                             AutomationProperties.Name="Program file"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Content="Open file location" Click="OnRevealProcess"
                                                IsEnabled="{Binding SelHasPath}" AutomationProperties.AutomationId="procs-reveal"/>
                                        <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Content="Search online" Click="OnSearchProcess"
                                                ToolTip="What is it? Looks it up in your browser" AutomationProperties.AutomationId="procs-search"/>
                                        <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Content="Ask Aqua" Click="OnAskProcess"
                                                ToolTip="Ask what it is and whether its use is normal (opens a new chat)" AutomationProperties.AutomationId="procs-ask"/>
                                        <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Content="{Binding EndLabel}" Click="OnEndProcess"
                                                IsEnabled="{Binding SelCanEnd}" ToolTip="{Binding SelEndTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="procs-end"/>
                                        <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Content="Force end" Click="OnForceEndProcess"
                                                Visibility="{Binding ShowForceEnd, Converter={StaticResource Vis}}" ToolTip="Stops it without letting it save" AutomationProperties.AutomationId="procs-force-end"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SelStatus}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Visibility="{Binding HasSelStatus, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </c:Card>
                    <c:Card Title="Storage" Icon="disk" Margin="0,16,0,0" Subtitle="{Binding StorageSub}">
                        <c:Card.HeaderAction>
                            <Button Style="{StaticResource Btn.Link}" Content="Storage settings" Click="OnTool" Tag="storage" FontSize="12.5" AutomationProperties.AutomationId="storage-settings"/>
                        </c:Card.HeaderAction>
                        <ItemsControl ItemsSource="{Binding Disks}" AutomationProperties.AutomationId="storage-drives">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource B.Text3}"/></TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource T.Caption}" Margin="10,0,0,0"/>
                                        </Grid>
                                        <c:Bar Value="{Binding Value}" Fill="{Binding Brush}" Track="{DynamicResource B.Track}" Height="6" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource Btn.Link}" Padding="0,2" Margin="0,0,14,0" FontSize="12.5" Content="Open" Tag="{Binding Name}" Click="OnOpenDrive"
                                                    ToolTip="Open in File Explorer" AutomationProperties.Name="{Binding OpenName}"/>
                                            <Button Style="{StaticResource Btn.Link}" Padding="0,2" Margin="0,0,14,0" FontSize="12.5" Content="Clean up" Tag="{Binding Name}" Click="OnCleanDrive"
                                                    ToolTip="Disk Cleanup for this drive: temporary files, update leftovers, the Recycle Bin" AutomationProperties.Name="{Binding CleanName}"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Windows' own maintenance tools, grouped -->
                    <c:Card Title="Doctor's toolkit" Icon="wrench" Subtitle="Windows' own maintenance tools" AutomationProperties.AutomationId="system-toolkit">
                        <ItemsControl ItemsSource="{Binding ToolGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Overline}" FontSize="11.5" Margin="0,2,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Btn.Standard}" Padding="10,5" FontSize="12.5" Margin="0,0,6,6" Tag="{Binding Id}" Click="OnTool"
                                                            ToolTip="{Binding What}" AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <c:Icon Kind="{Binding Icon}" Width="13" Height="13"/>
                                                            <TextBlock Text="{Binding Name}" Margin="7,0,0,0"/>
                                                            <TextBlock Text=" ⛨" Foreground="{DynamicResource B.Text3}" Visibility="{Binding Admin, Converter={StaticResource Vis}}" ToolTip="Windows asks for administrator permission"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:Card>
                    <c:Card Title="Local AI runtime" Icon="cube" Subtitle="{Binding AiSub}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding AiModel}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AiState}" Style="{StaticResource T.Body2}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Actions on their own row: they wrap on narrow windows instead of covering the status. -->
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Btn.Standard}" Click="OnToggleOllama" Margin="0,0,8,0" Visibility="{Binding ShowOllamaToggle, Converter={StaticResource Vis}}"
                                            IsEnabled="{Binding OllamaIdle}" ToolTip="Start or stop the local Ollama server" AutomationProperties.AutomationId="system-ollama-toggle">
                                        <TextBlock Text="{Binding OllamaLabel}"/>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Standard}" Click="OnToggleAi" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding PauseLabel}"/>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Standard}" Click="OnFreeVram" ToolTip="Unload models from the GPU now" IsEnabled="{Binding AiReachable}">
                                        <StackPanel Orientation="Horizontal"><c:Icon Kind="gpu" Width="14" Height="14"/><TextBlock Text="Free VRAM" Margin="8,0,0,0"/></StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,16,0,8">
                                <StackPanel>
                                    <TextBlock Text="Speed" Style="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding TokensPerSecond}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="AI calls since start" Style="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding Calls}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tokens generated" Style="{StaticResource T.Caption}"/>
                                    <TextBlock Text="{Binding Tokens}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Loaded in GPU memory" Style="{StaticResource T.Overline}" FontSize="12" Margin="0,8,0,6"/>
                            <ItemsControl ItemsSource="{Binding Loaded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No model loaded — VRAM is free for games and apps." Style="{StaticResource T.Body2}" Visibility="{Binding Loaded, Converter={StaticResource VisNot}}"/>
                            <Border Style="{StaticResource CardInner}" Margin="0,12,0,0" Visibility="{Binding ShowSetupHint, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="Aqua's AI runs in Ollama, on this PC. Install or start it, then pull a model such as qwen3.5:9b — everything else keeps working meanwhile."
                                               Style="{StaticResource T.Body2}" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource Btn.Link}" Click="OnGetOllama" HorizontalAlignment="Left" Margin="-6,4,0,0" Content="Get Ollama (ollama.com)"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Installed models" Style="{StaticResource T.Overline}" FontSize="12" Margin="0,14,0,6" Visibility="{Binding Installed, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding Installed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </c:Card>
                    <c:Card Title="Aqua Hub itself" Icon="shield" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelfText}" Style="{StaticResource T.Body2}"/>
                            <TextBlock Text="Closing the dashboard hides it (reopening is instant), and its memory is handed back to Windows while the agents work in the background." Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
