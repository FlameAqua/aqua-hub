<Window x:Class="AquaHub.UI.Shell.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AquaHub.UI.Controls"
        xmlns:ui="clr-namespace:AquaHub.UI"
        Title="Aqua Hub quick panel" Width="392" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource F.Text}" Foreground="{DynamicResource B.Text}" FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>
        <Border x:Name="Fallback" Background="{DynamicResource B.Flyout}" BorderBrush="{DynamicResource B.CardStroke}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed"/>
        <!-- Header (fixed) · body (scrolls when the screen is short) · command box (fixed) -->
        <Grid Margin="0,14,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Margin="16,0,16,0">

                <!-- Clock + weather -->
                <Grid Margin="2,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="ClockText" FontFamily="{StaticResource F.Display}" FontSize="34" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="DateText" Style="{StaticResource T.Caption}" FontSize="13" Margin="1,-2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HasWeather, Converter={StaticResource Vis}}">
                        <c:WeatherIcon Code="{Binding WeatherCode}" IsDay="{Binding IsDay}" Width="44" Height="44"/>
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Temp}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Condition}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Border>
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,12,0" Focusable="False">
                <StackPanel Margin="0,0,4,0">
                    <!-- Brief -->
                    <Button Style="{StaticResource Btn.Row}" Click="OnOpenBrief" Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource B.Hero}" AutomationProperties.Name="Open today's brief"
                            BorderBrush="{DynamicResource B.AccentSoft}" BorderThickness="1" ui:UiProps.CornerRadius="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <c:Icon Kind="sparkle" Width="12" Height="12" Foreground="{DynamicResource B.AccentText}"/>
                                <TextBlock Text="{Binding BriefTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BriefSummary}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}" MaxHeight="57" LineHeight="19" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </Button>

                    <!-- Markets 2x2 -->
                    <ItemsControl ItemsSource="{Binding FlyoutTiles}" Margin="-3,0,-3,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Margin="3" Padding="10,8" Background="{DynamicResource B.CardInner}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,54,0"/>
                                            <TextBlock Text="{Binding ChangeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <c:Sparkline Values="{Binding Intraday}" Baseline="{Binding Baseline}" Stroke="{Binding ChangeBrush}" Height="20" Margin="0,6,0,0" Thickness="1.3"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Headlines -->
                    <TextBlock Text="Headlines" Style="{StaticResource T.Overline}" FontSize="12" Margin="2,4,0,4"/>
                    <ItemsControl x:Name="Headlines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Padding="8,6" Margin="-6,0,-6,0" ToolTip="{Binding Tldr}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="WordEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SourcesText}" Style="{StaticResource T.Caption}" FontSize="11" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding TimeAgo, StringFormat=' · {0}'}" Style="{StaticResource T.Caption}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,8"/>

                    <!-- Now playing -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource B.Brand}">
                            <Grid>
                                <c:Icon Kind="music" Width="18" Height="18" Foreground="White" Visibility="{Binding HasArt, Converter={StaticResource VisNot}}"/>
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Border.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8"/></Border.Clip>
                                    <Image Source="{Binding MediaArt}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaTitleText" Text="{Binding MediaTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MediaArtist}" Style="{StaticResource T.Caption}" Visibility="{Binding HasMedia, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource Btn.Link}" Command="{Binding OpenMusicCommand}" HorizontalAlignment="Left" Margin="-6,0,0,0" Padding="6,1"
                                    Visibility="{Binding HasMedia, Converter={StaticResource VisNot}}">
                                <TextBlock Text="{Binding MusicAppName, StringFormat='Play something on {0}'}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Media}" Width="34" Height="34" Command="{Binding PrevCommand}" ToolTip="Previous"><c:Icon Kind="previous" Width="14" Height="14"/></Button>
                            <Button Style="{StaticResource Btn.MediaMain}" Width="36" Height="36" Command="{Binding PlayPauseCommand}" Margin="2,0" ToolTip="Play / pause"><c:Icon Kind="{Binding PlayIcon}" Width="15" Height="15"/></Button>
                            <Button Style="{StaticResource Btn.Media}" Width="34" Height="34" Command="{Binding NextCommand}" ToolTip="Next"><c:Icon Kind="next" Width="14" Height="14"/></Button>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding MuteCommand}" ToolTip="Mute"><c:Icon Kind="{Binding VolumeIcon}" Width="14" Height="14"/></Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" Margin="4,0,0,0" AutomationProperties.Name="Volume"/>
                    </Grid>

                    <Rectangle Style="{StaticResource Divider}" Margin="0,8"/>

                    <!-- PC load (opens This PC) -->
                    <Button Style="{StaticResource Btn.Row}" Click="OnOpenPc" Margin="-8,0,-8,0" Padding="8,6" AutomationProperties.AutomationId="flyout-pc"
                            AutomationProperties.Name="Show This PC" ToolTip="Processes, storage, network and the local AI runtime">
                    <UniformGrid Columns="3" Margin="0,2,0,4">
                        <StackPanel Margin="0,0,8,0">
                            <Grid><TextBlock Text="CPU" Style="{StaticResource T.Caption}"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            <c:Bar Value="{Binding Cpu, Converter={x:Static ui:Percent.ToFraction}}" Fill="{Binding CpuBrush}" Track="{DynamicResource B.Track}" Height="4" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <Grid><TextBlock Text="RAM" Style="{StaticResource T.Caption}"/><TextBlock Text="{Binding Ram, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            <c:Bar Value="{Binding Ram, Converter={x:Static ui:Percent.ToFraction}}" Fill="{Binding RamBrush}" Track="{DynamicResource B.Track}" Height="4" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <Grid><TextBlock Text="GPU" Style="{StaticResource T.Caption}"/><TextBlock Text="{Binding Gpu, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            <c:Bar Value="{Binding Gpu, Converter={x:Static ui:Percent.ToFraction}}" Fill="{Binding GpuBrush}" Track="{DynamicResource B.Track}" Height="4" Margin="0,5,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    </Button>

                    <!-- Next up (opens Upcoming) -->
                    <Button x:Name="NextEventButton" Style="{StaticResource Btn.Row}" Click="OnOpenUpcoming" Margin="-8,4,-8,0" Padding="8,4"
                            AutomationProperties.AutomationId="flyout-next-event" AutomationProperties.Name="Show your agenda" ToolTip="Your agenda and predictions">
                        <ContentControl x:Name="NextEvent" ContentTemplate="{StaticResource Tpl.EventRow}" Focusable="False"/>
                    </Button>

                    <!-- Quick launch -->
                    <ItemsControl ItemsSource="{Binding FlyoutApps}" Margin="-8,8,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Base}" Command="{Binding LaunchCommand}" Padding="4" ToolTip="{Binding Name}" ui:UiProps.CornerRadius="8" Height="48" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                    <Grid Width="30" Height="30">
                                        <Border CornerRadius="8" Background="{DynamicResource B.Brand}" Visibility="{Binding HasIcon, Converter={StaticResource VisNot}}">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Scenes}" ItemTemplate="{StaticResource Tpl.ScenePill}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="16,0,16,0">
                <!-- Command box -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Command" AutomationProperties.AutomationId="flyout-command" ui:UiProps.Placeholder="Ask, or try “pause” · “open spotify”" ToolTip="Ask a question, or type a command such as “pause”, “focus mode” or “open spotify”" KeyDown="OnCommandKey" Padding="10,0" FontSize="13"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Click="OnOpenHub" ToolTip="Open Aqua Hub" Margin="6,0,0,0"><c:Icon Kind="expand" Width="16" Height="16"/></Button>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Click="OnSettings" ToolTip="Settings"><c:Icon Kind="settings" Width="16" Height="16"/></Button>
                </Grid>
                <TextBlock x:Name="CommandResult" Style="{StaticResource T.Caption}" Margin="4,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
