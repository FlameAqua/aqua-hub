<Window x:Class="AquaHub.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AquaHub.UI.Controls"
        xmlns:ui="clr-namespace:AquaHub.UI"
        Title="Aqua Hub" Width="1440" Height="920" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource F.Text}" Foreground="{DynamicResource B.Text}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="/Assets/AquaHub.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Deck.Action" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="22" Background="{DynamicResource B.Popup}" IsHitTestVisible="False">
                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.24"/></Border.Effect>
                            </Border>
                            <Border x:Name="Circle" CornerRadius="22" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.ControlStrokeStrong}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                <Setter TargetName="Circle" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource B.OnAccent}"/>
                                <Setter TargetName="Circle" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Fallback" Grid.ColumnSpan="2" Background="{DynamicResource B.WindowOpaque}" Visibility="Collapsed"/>

        <!-- ══════════ Navigation ══════════ -->
        <Grid x:Name="Nav" Width="228" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/AquaHub.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="BrandText" Text="Aqua Hub" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,6,0,0" x:Name="NavItems">
                <RadioButton Style="{StaticResource NavItem}" Tag="today" ui:UiProps.Icon="home" Content="Today" IsChecked="True" ToolTip="Today (Ctrl+1)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="news" ui:UiProps.Icon="news" Content="News" ToolTip="News (Ctrl+2)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="social" ui:UiProps.Icon="social" Content="Social pulse" ToolTip="Social pulse (Ctrl+3)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="markets" ui:UiProps.Icon="markets" Content="Markets" ToolTip="Markets (Ctrl+4)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="upcoming" ui:UiProps.Icon="upcoming" Content="Upcoming" ToolTip="Agenda &amp; predictions (Ctrl+5)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="system" ui:UiProps.Icon="system" Content="This PC" ToolTip="This PC (Ctrl+6)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="launchpad" ui:UiProps.Icon="launchpad" Content="Launchpad" ToolTip="Apps, music &amp; scenes (Ctrl+7)"/>
                <Rectangle Style="{StaticResource Divider}" Margin="18,8"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="ask" ui:UiProps.Icon="ask" Content="Ask Aqua" ToolTip="Ask Aqua (Ctrl+8)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="search" ui:UiProps.Icon="search" Content="Search files" ToolTip="Search your folders" AutomationProperties.AutomationId="nav-search"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="workbench" ui:UiProps.Icon="wand" Content="Workbench" ToolTip="Teach Aqua skills and things to remember"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="agents" ui:UiProps.Icon="agents" Content="Agents" ToolTip="Agents (Ctrl+9)"/>
                <RadioButton Style="{StaticResource NavItem}" Tag="models" ui:UiProps.Icon="cube" Content="Models" ToolTip="Your local model library" AutomationProperties.AutomationId="nav-models"/>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <!-- AI status -->
                <Button x:Name="AiStatus" Style="{StaticResource Btn.Row}" Margin="10,0,10,4" Padding="10,8" Click="OnAiStatusClick" ToolTip="Local AI status">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20">
                            <c:Icon Kind="cube" Width="18" Height="18" Foreground="{DynamicResource B.Text2}"/>
                            <Ellipse x:Name="AiDot" Width="8" Height="8" Fill="{DynamicResource B.Up}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-1"
                                     Stroke="{DynamicResource B.Window}" StrokeThickness="1.5"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="AiModel" Text="Local AI" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AiState" Text="Checking…" Style="{StaticResource T.Caption}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <RadioButton x:Name="SettingsNav" Style="{StaticResource NavItem}" Tag="settings" ui:UiProps.Icon="settings" Content="Settings" ToolTip="Settings (Ctrl+,)"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ Content ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: the command box shrinks with the window (the status text makes way first) -->
            <Grid x:Name="TitleBar" Margin="0,0,150,0" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CommandBox" Style="{StaticResource Btn.Standard}" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Left" VerticalAlignment="Center"
                        MaxWidth="480" MinWidth="150" Height="24" Margin="32,4,12,4" Padding="10,0" HorizontalContentAlignment="Stretch" Click="OnCommandBoxClick"
                        ToolTip="Ask anything or run a command (Ctrl+K)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:Icon Kind="ask" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}"/>
                        <TextBlock Grid.Column="1" Text="Ask Aqua or type a command…" Foreground="{DynamicResource B.Text3}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="CommandKeyHint" Grid.Column="2" CornerRadius="4" Background="{DynamicResource B.Subtle}" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource B.Text3}"/>
                        </Border>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SyncText" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" Background="Transparent"
                               AutomationProperties.AutomationId="sync-status"/>
                    <!-- The tooltip also lists when each area last updated, so the accessible name is fixed here -->
                    <Button x:Name="RefreshButton" Style="{StaticResource Btn.Icon}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnRefreshClick" ToolTip="Refresh everything (F5)"
                            AutomationProperties.Name="Refresh everything" AutomationProperties.AcceleratorKey="F5">
                        <c:Icon Kind="refresh" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="BellButton" Style="{StaticResource Btn.Icon}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnBellClick" ToolTip="Alerts" Margin="2,0,0,0">
                        <Grid Width="18" Height="18">
                            <c:Icon Kind="bell" Width="17" Height="17"/>
                            <Border x:Name="BellBadge" MinWidth="14" Height="14" CornerRadius="7" Background="{DynamicResource B.Down}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,-6,-8,0" Padding="3,0" Visibility="Collapsed">
                                <TextBlock x:Name="BellCount" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"
                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="DndButton" Style="{StaticResource Btn.Icon}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnDndClick" ToolTip="Do not disturb" Margin="2,0,0,0"
                            AutomationProperties.AutomationId="dnd-toggle">
                        <c:Icon x:Name="DndIcon" Kind="bell-off" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Page layer -->
            <Border Grid.Row="1" Background="{DynamicResource B.Layer}" BorderBrush="{DynamicResource B.LayerStroke}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" Panel.ZIndex="2" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="720" Margin="16,12,16,0">
                        <!-- Offline notice: the hub keeps working from what it already collected -->
                        <c:GroupBorder x:Name="OfflineBar" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="12" Padding="14,9" Margin="0,0,0,8" Visibility="Collapsed"
                                AutomationProperties.AutomationId="offline-bar" AutomationProperties.Name="Offline">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:Icon Kind="wifi-off" Width="16" Height="16" Foreground="{DynamicResource B.Warn}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OfflineText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Standard}" Padding="12,4" FontSize="12.5" Click="OnRefreshClick" Content="Try again"/>
                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="6,0,0,0" Click="OnOfflineBarDismiss"
                                            ToolTip="Dismiss offline notice" AutomationProperties.Name="Dismiss offline notice">
                                        <c:Icon Kind="close" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </c:GroupBorder>
                        <!-- A new version: on offer, downloading, ready to install ("Not now" puts it away until the next step) -->
                        <c:GroupBorder x:Name="UpdateBar" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="12" Padding="14,9" Visibility="Collapsed"
                                AutomationProperties.AutomationId="update-bar" AutomationProperties.Name="Update">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:Icon Kind="download" Width="16" Height="16" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateBarText" TextWrapping="Wrap" FontSize="13" AutomationProperties.AutomationId="update-bar-text" AutomationProperties.LiveSetting="Polite"/>
                                    <ProgressBar x:Name="UpdateBarProgress" Height="4" Maximum="100" Margin="0,6,0,1" Visibility="Collapsed"
                                                 AutomationProperties.Name="Update download" AutomationProperties.AutomationId="update-bar-progress"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="UpdateBarNotes" Style="{StaticResource Btn.Link}" Content="What's new" Click="OnUpdateBarNotes" Margin="0,0,10,0" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="update-bar-notes"/>
                                    <Button x:Name="UpdateBarAction" Style="{StaticResource Btn.Accent}" Padding="12,4" FontSize="12.5" Click="OnUpdateBarAction"
                                            AutomationProperties.AutomationId="update-bar-action"/>
                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="6,0,0,0" Click="OnUpdateBarDismiss" ToolTip="Not now"
                                            AutomationProperties.Name="Not now" AutomationProperties.AutomationId="update-bar-dismiss">
                                        <c:Icon Kind="close" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </c:GroupBorder>
                    </StackPanel>
                    <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <Canvas x:Name="DeckSurface" Grid.Row="1" ClipToBounds="True" SizeChanged="OnDeckSizeChanged">
                        <Canvas x:Name="DeckActions" Visibility="Collapsed" Width="{Binding ActualWidth, ElementName=DeckSurface}" Height="{Binding ActualHeight, ElementName=DeckSurface}">
                            <Button x:Name="DeckAsk" Style="{StaticResource Deck.Action}" Click="OnDeckAsk" ToolTip="Ask Aqua" AutomationProperties.Name="Ask Aqua" AutomationProperties.AutomationId="deck-ask"><c:Icon Kind="sparkle" Width="19" Height="19"/></Button>
                            <Button x:Name="DeckSearch" Style="{StaticResource Deck.Action}" Click="OnDeckSearch" ToolTip="Search files" AutomationProperties.Name="Search files" AutomationProperties.AutomationId="deck-search"><c:Icon Kind="search" Width="19" Height="19"/></Button>
                            <Button x:Name="DeckLaunchpad" Style="{StaticResource Deck.Action}" Click="OnDeckLaunchpad" ToolTip="Launchpad" AutomationProperties.Name="Launchpad" AutomationProperties.AutomationId="deck-launchpad"><c:Icon Kind="launchpad" Width="18" Height="18"/></Button>
                            <Button x:Name="DeckToday" Style="{StaticResource Deck.Action}" Click="OnDeckToday" ToolTip="Today's agenda" AutomationProperties.Name="Today's agenda" AutomationProperties.AutomationId="deck-today"><c:Icon Kind="upcoming" Width="18" Height="18"/></Button>
                            <Button x:Name="DeckAdd" Style="{StaticResource Deck.Action}" Click="OnDeckAddReminder" ToolTip="Add reminder" AutomationProperties.Name="Add reminder" AutomationProperties.AutomationId="deck-add-reminder"><c:Icon Kind="bell" Width="18" Height="18"/></Button>
                            <Button x:Name="DeckTimer" Style="{StaticResource Deck.Action}" Click="OnDeckTimer" ToolTip="Quick timer" AutomationProperties.Name="Quick timer" AutomationProperties.AutomationId="deck-timer"><c:Icon Kind="clock" Width="18" Height="18"/></Button>
                            <Button x:Name="DeckHide" Style="{StaticResource Deck.Action}" Click="OnHideDeck" ToolTip="Hide deck" AutomationProperties.Name="Hide deck" AutomationProperties.AutomationId="deck-hide"><c:Icon Kind="close" Width="16" Height="16"/></Button>
                            <Button x:Name="DeckApp1" Style="{StaticResource Deck.Action}" Click="OnDeckPinnedApp" AutomationProperties.AutomationId="deck-app-1"/>
                            <Button x:Name="DeckApp2" Style="{StaticResource Deck.Action}" Click="OnDeckPinnedApp" AutomationProperties.AutomationId="deck-app-2"/>
                        </Canvas>
                        <c:GroupBorder x:Name="DeckTimerPanel" Width="164" Height="194" CornerRadius="16"
                                       Padding="12" BorderThickness="1" Visibility="Collapsed"
                                       Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.ControlStrokeStrong}"
                                       AutomationProperties.Name="Quick timer" AutomationProperties.AutomationId="deck-timer-panel">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Click="OnCloseDeckTimer"
                                            ToolTip="Close timer" AutomationProperties.Name="Close timer"><c:Icon Kind="close" Width="13" Height="13"/></Button>
                                    <TextBlock Text="Timer" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Width="92" Height="92" Margin="0,5,0,8">
                                    <c:RingGauge x:Name="DeckTimerRing" ValueBrush="{DynamicResource B.Accent}" TrackBrush="{DynamicResource B.Track}"
                                                 TextBrush="{DynamicResource B.Text}" Thickness="5" IsHitTestVisible="False"
                                                 AutomationProperties.AutomationId="deck-timer-readout"/>
                                    <c:TimerDial x:Name="DeckDial" Minimum="1" Maximum="60" Value="5" SmallChange="1" LargeChange="5"
                                                 FocusVisualStyle="{StaticResource Focus}" ValueChanged="OnDeckDurationChanged"
                                                 AutomationProperties.Name="Timer duration in minutes" AutomationProperties.AutomationId="deck-timer-duration"
                                                 ToolTip="Turn the dial or use the arrow keys to choose minutes">
                                        <c:TimerDial.Template><ControlTemplate TargetType="c:TimerDial"><Border Background="Transparent" CornerRadius="46" Cursor="Hand"/></ControlTemplate></c:TimerDial.Template>
                                    </c:TimerDial>
                                </Grid>
                                <Button x:Name="DeckTimerCommand" Style="{StaticResource Btn.Accent}" Content="Start" Click="OnDeckTimerCommand"
                                        AutomationProperties.AutomationId="deck-timer-command"/>
                            </StackPanel>
                        </c:GroupBorder>
                        <c:DeckGrip x:Name="DeckHandle" Width="56" Height="56" Focusable="True" Cursor="Hand"
                                    DragStarted="OnDeckDragStarted" DragDelta="OnDeckDrag" DragCompleted="OnDeckDragCompleted"
                                    PreviewKeyDown="OnDeckMoveKey" ToolTip="Open Deck · drag to move"
                                    AutomationProperties.Name="Open Deck" AutomationProperties.AutomationId="deck-move"
                                    AutomationProperties.HelpText="Press Enter to open Deck. Use the arrow keys to move it.">
                            <c:DeckGrip.Template>
                                <ControlTemplate TargetType="c:DeckGrip">
                                    <Grid>
                                      <Border CornerRadius="28" Background="{DynamicResource B.Popup}" IsHitTestVisible="False">
                                          <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28"/></Border.Effect>
                                      </Border>
                                      <Border x:Name="Grip" CornerRadius="28" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1.5">
                                        <Grid>
                                            <c:Icon x:Name="DeckLogo" Kind="bolt" Width="22" Height="22" Foreground="{DynamicResource B.AccentText}" Visibility="Collapsed"/>
                                            <StackPanel x:Name="Countdown" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <c:Icon x:Name="CountdownClock" Kind="clock" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}"/>
                                                <TextBlock x:Name="CountdownTime" Text="{TemplateBinding Countdown}"
                                                           HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}"/>
                                            </StackPanel>
                                        </Grid>
                                      </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsOpen" Value="True">
                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource B.Accent}"/>
                                            <Setter TargetName="DeckLogo" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownClock" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownTime" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource B.Accent}"/>
                                            <Setter TargetName="DeckLogo" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownClock" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownTime" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource B.Accent}"/>
                                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="DeckLogo" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownClock" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                            <Setter TargetName="CountdownTime" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="BorderThickness" Value="3"/></Trigger>
                                        <Trigger Property="Countdown" Value="{x:Null}">
                                            <Setter TargetName="DeckLogo" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Countdown" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </c:DeckGrip.Template>
                        </c:DeckGrip>
                    </Canvas>
                    <StackPanel x:Name="Banners" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380"/>
                    <c:FeedbackPopup x:Name="WorkspaceFeedback" Grid.Row="1" Panel.ZIndex="3"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Alerts popup -->
        <!-- Local AI: status and the Ollama server on/off switch (click the model status in the sidebar) -->
        <Popup x:Name="AiPopup" PlacementTarget="{Binding ElementName=AiStatus}" Placement="Top" VerticalOffset="-6"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <c:GroupBorder Margin="10,16,10,10" Width="320" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="10"
                    AutomationProperties.AutomationId="ai-popup" AutomationProperties.Name="Local AI">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.32" Color="Black"/>
                </Border.Effect>
                <StackPanel Margin="16,14,16,14">
                    <TextBlock Text="Local AI · Ollama" Style="{StaticResource T.CardTitle}"/>
                    <TextBlock x:Name="AiPopupStatus" Style="{StaticResource T.Body2}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AiPopupDetail" Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="AiPopupToggle" Style="{StaticResource Btn.Accent}" Click="OnAiServerToggle" AutomationProperties.AutomationId="ai-server-toggle"/>
                        <Button Style="{StaticResource Btn.Standard}" Margin="8,0,0,0" Content="Agents" Click="OnAiPopupAgents"/>
                        <Button Style="{StaticResource Btn.Standard}" Margin="8,0,0,0" Content="Settings" Click="OnAiPopupSettings"/>
                    </StackPanel>
                </StackPanel>
            </c:GroupBorder>
        </Popup>

        <Popup x:Name="AlertsPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" HorizontalOffset="-330" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <c:GroupBorder Margin="10,0,10,16" Width="400" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="10"
                           AutomationProperties.AutomationId="alerts-popup" AutomationProperties.Name="Alerts" PreviewKeyDown="OnAlertsKey">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.32" Color="Black"/>
                </Border.Effect>
                <DockPanel Margin="6">
                    <Grid DockPanel.Dock="Top" Margin="10,8,6,6">
                        <TextBlock Text="Alerts" Style="{StaticResource T.CardTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Link}" Content="Mark all read" Click="OnMarkRead"/>
                            <Button Style="{StaticResource Btn.Link}" Content="Clear" Click="OnClearAlerts"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NoAlerts" DockPanel.Dock="Top" Text="You're all caught up." Style="{StaticResource T.Body2}" Margin="12,6,12,14"/>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlertList" ItemTemplate="{StaticResource Tpl.AlertRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </c:GroupBorder>
        </Popup>

        <!-- Modal overlay (onboarding / dialogs) -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource B.Scrim}"/>
            <ContentControl x:Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
