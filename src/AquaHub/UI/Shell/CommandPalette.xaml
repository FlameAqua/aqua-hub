<Window x:Class="AquaHub.UI.Shell.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AquaHub.UI.Controls"
        xmlns:ui="clr-namespace:AquaHub.UI"
        Title="Aqua command palette" Width="700" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{StaticResource F.Text}" Foreground="{DynamicResource B.Text}" FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Border x:Name="Fallback" Background="{DynamicResource B.Flyout}" BorderBrush="{DynamicResource B.CardStroke}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed"/>
        <StackPanel Margin="8">
            <Grid Margin="10,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <c:Icon Kind="ask" Width="20" Height="20" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center"/>
                <TextBox x:Name="Input" Grid.Column="1" Margin="10,0,10,0" FontSize="18" Background="Transparent" BorderBrush="Transparent"
                         ui:UiProps.Placeholder="Ask Aqua anything, or type a command…" Height="44" Padding="4,0" TextChanged="OnTextChanged" PreviewKeyDown="OnInputKey"/>
                <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource B.Subtle}" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource B.Text3}"/>
                </Border>
            </Grid>
            <Rectangle Style="{StaticResource Divider}"/>

            <!-- Answer (inline Ask) -->
            <Border x:Name="AnswerPanel" Margin="10,10,10,4" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <c:Icon Kind="sparkle" Width="13" Height="13" Foreground="{DynamicResource B.AccentText}"/>
                        <TextBlock x:Name="AnswerLabel" Text="Aqua" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="AnswerText" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Btn.Standard}" Padding="10,4" FontSize="12" Click="OnContinueInAsk">
                            <StackPanel Orientation="Horizontal"><c:Icon Kind="message" Width="13" Height="13"/><TextBlock Text="Continue in Ask" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListBox x:Name="Results" Style="{StaticResource PlainList}" MaxHeight="420" Margin="0,6,0,0" MouseUp="OnResultClick" Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource B.Subtle}">
                                <Grid>
                                    <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource B.AccentText}"/>
                                    <Image Source="{Binding Image}" Width="24" Height="24"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Caption}" Visibility="{Binding Subtitle, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="12,8,12,4">
                <TextBlock x:Name="Footer" Style="{StaticResource T.Caption}" Text="↑↓ choose  ·  Enter run  ·  Tab ask Aqua  ·  Esc close"/>
                <TextBlock x:Name="Status" Style="{StaticResource T.Caption}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
