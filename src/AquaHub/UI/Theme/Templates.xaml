<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AquaHub.UI.Controls"
                    xmlns:ui="clr-namespace:AquaHub.UI"
                    xmlns:svc="clr-namespace:AquaHub.Services">

    <!-- Compact story row (Today, flyout) -->
    <DataTemplate x:Key="Tpl.StoryRow">
        <Button Style="{StaticResource Btn.Row}" Command="{Binding ToggleCommand}" Margin="-10,0,-10,2" ToolTip="{Binding SourcesText}" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Headline}" MaxHeight="42" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Tldr}" Style="{StaticResource T.Body2}" MaxHeight="38" Margin="0,3,0,0" LineStackingStrategy="BlockLineHeight"
                               Visibility="{Binding Tldr, Converter={StaticResource Vis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding CategoryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource T.Caption}" Margin="6,0,0,0" Foreground="{Binding CategoryBrush}"/>
                        <TextBlock Text=" · " Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="{Binding SourcesText}" Style="{StaticResource T.Caption}" MaxWidth="230"/>
                        <TextBlock Text=" · " Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource T.Caption}"/>
                        <c:Icon Kind="sparkle" Width="10" Height="10" Margin="8,0,0,0" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center"
                                Visibility="{Binding IsAi, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <!-- Expanded: key points + why + actions -->
                    <StackPanel Margin="0,10,0,4" Visibility="{Binding Expanded, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding KeyPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource B.AccentText}" VerticalAlignment="Top" Margin="2,7,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body2}" Foreground="{DynamicResource B.Text}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Why}" Style="{StaticResource T.Body2}" FontStyle="Italic" Margin="0,6,0,0" Foreground="{DynamicResource B.AccentText}"
                                   Visibility="{Binding Why, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Btn.Standard}" Command="{Binding OpenCommand}" Padding="10,4" FontSize="12">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="external" Width="13" Height="13"/><TextBlock Text="Read" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Subtle}" Command="{Binding AskCommand}" Padding="10,4" FontSize="12" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal"><c:Icon Kind="ask" Width="13" Height="13"/><TextBlock Text="Ask Aqua" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="86" Height="64" CornerRadius="8" Margin="14,2,0,0" VerticalAlignment="Top" ClipToBounds="True"
                        Background="{DynamicResource B.Skeleton}" Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,86,64" RadiusX="8" RadiusY="8"/>
                    </Border.Clip>
                    <Image svc:Img.Url="{Binding ImageUrl}" svc:Img.DecodeWidth="180" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Quote row -->
    <DataTemplate x:Key="Tpl.QuoteRow">
        <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Margin="-10,0,-10,0" Padding="10,6" AutomationProperties.Name="{Binding Name}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource B.Up}" VerticalAlignment="Center" Margin="0,0,5,0"
                                 Visibility="{Binding IsOpen, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource T.Caption}"/>
                    </StackPanel>
                </StackPanel>
                <c:Sparkline Grid.Column="1" Values="{Binding Intraday}" Baseline="{Binding Baseline}" Stroke="{Binding ChangeBrush}" Height="26" Margin="6,0" FillArea="False" Thickness="1.4"/>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="86">
                    <TextBlock Text="{Binding PriceText}" Style="{StaticResource T.Number}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <Border CornerRadius="5" Background="{Binding ChangeSoft}" Padding="6,1" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock Text="{Binding ChangeText}" Style="{StaticResource T.Number}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Agenda row with date badge -->
    <DataTemplate x:Key="Tpl.EventRow">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="44" CornerRadius="8" Background="{DynamicResource B.CardInner}" VerticalAlignment="Top">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" CornerRadius="8,8,0,0" Background="{Binding KindBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Month}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,1,0,0">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource T.Caption}"/>
                    <TextBlock Text=" · " Style="{StaticResource T.Caption}"/>
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource T.Caption}" Foreground="{Binding KindBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" Visibility="{Binding Detail, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Prediction row -->
    <DataTemplate x:Key="Tpl.PredictionRow">
        <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Margin="-10,0,-10,2" ToolTip="{Binding Meta}" AutomationProperties.Name="{Binding Title}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" MaxHeight="36"
                           TextTrimming="WordEllipsis"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LeadLabel}" Style="{StaticResource T.Caption}" Foreground="{DynamicResource B.Text2}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding ChangeText}" FontSize="11" Foreground="{Binding ChangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LeadProbText}" Style="{StaticResource T.Number}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <c:Bar Value="{Binding LeadProb}" Fill="{DynamicResource B.Accent}" Track="{DynamicResource B.Track}" Height="5" Margin="0,5,0,0"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Social post row -->
    <DataTemplate x:Key="Tpl.PostRow">
        <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" Margin="-10,0,-10,2" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource B.Subtle}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{Binding PlatformBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PlatformLabel}" FontSize="11" Foreground="{DynamicResource B.Text2}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="360"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Headline}" FontSize="14" Margin="0,6,0,0" MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Body}" Style="{StaticResource T.Body2}" Margin="0,3,0,0" MaxHeight="38" LineStackingStrategy="BlockLineHeight"
                               Visibility="{Binding Body, Converter={StaticResource Vis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ScoreText, Converter={StaticResource Vis}}" Margin="0,0,12,0">
                            <c:Icon Kind="arrow-up" Width="12" Height="12" Foreground="{DynamicResource B.Text3}"/>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource T.Caption}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CommentsText, Converter={StaticResource Vis}}">
                            <c:Icon Kind="message" Width="12" Height="12" Foreground="{DynamicResource B.Text3}"/>
                            <TextBlock Text="{Binding CommentsText}" Style="{StaticResource T.Caption}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="72" Height="56" CornerRadius="8" Margin="12,2,0,0" VerticalAlignment="Top" Background="{DynamicResource B.Skeleton}"
                        Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,72,56" RadiusX="8" RadiusY="8"/>
                    </Border.Clip>
                    <Image svc:Img.Url="{Binding ImageUrl}" svc:Img.DecodeWidth="150" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- App tile -->
    <DataTemplate x:Key="Tpl.AppTile">
        <Grid>
        <Button Style="{StaticResource Btn.Base}" Command="{Binding LaunchCommand}" Width="78" Padding="4,8" ui:UiProps.CornerRadius="10" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding LaunchCommand}" ui:UiProps.Icon="external"/>
                    <MenuItem Header="Close app" Command="{Binding CloseCommand}" ui:UiProps.Icon="close"/>
                    <Separator/>
                    <MenuItem Header="Remove from Launchpad" Command="{Binding RemoveCommand}" ui:UiProps.Icon="trash"/>
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel>
                <Grid Width="40" Height="40">
                    <Border CornerRadius="10" Background="{DynamicResource B.Brand}" Visibility="{Binding HasIcon, Converter={StaticResource VisNot}}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-9"
                             Visibility="{Binding IsRunning, Converter={StaticResource Vis}}"/>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="70"/>
            </StackPanel>
        </Button>
        <!-- Edit mode: a remove badge beside (not inside) the tile, so each is its own control for keyboards and screen readers. -->
        <Button Style="{StaticResource Btn.Base}" Width="22" Height="22" Padding="0" ui:UiProps.CornerRadius="11" Background="{DynamicResource B.Down}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,10,0" Command="{Binding RemoveCommand}"
                Visibility="{Binding IsEditing, Converter={StaticResource Vis}}" ToolTip="Remove from Launchpad"
                AutomationProperties.Name="{Binding Name, StringFormat=Remove {0} from Launchpad}">
            <c:Icon Kind="close" Width="10" Height="10" Foreground="White" StrokeThickness="2.4"/>
        </Button>
        </Grid>
    </DataTemplate>

    <!-- Scene pill -->
    <DataTemplate x:Key="Tpl.ScenePill">
        <Button Style="{StaticResource Btn.Standard}" Command="{Binding RunCommand}" Padding="12,6" Margin="0,0,8,8" ui:UiProps.CornerRadius="16"
                ToolTip="{Binding StepsText}" AutomationProperties.Name="{Binding Name, StringFormat=Run scene {0}}">
            <StackPanel Orientation="Horizontal">
                <c:Icon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}"/>
                <TextBlock Text="{Binding Name}" FontSize="13" Margin="7,0,0,0"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Alert row -->
    <DataTemplate x:Key="Tpl.AlertRow">
        <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource B.Subtle}" VerticalAlignment="Top">
                    <c:Icon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{Binding Brush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Body}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Body, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource T.Caption}"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource B.Accent}" HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding Unread, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
