<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AquaHub.UI.Controls"
                    xmlns:ui="clr-namespace:AquaHub.UI">

    <!-- ═════════════════════════ Typography ═════════════════════════ -->
    <FontFamily x:Key="F.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
        <Setter Property="FontSize" Value="24"/>
    </Style>
    <Style x:Key="T.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource T.Display}">
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="T.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Headline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextTrimming" Value="WordEllipsis"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="T.Body2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="TextTrimming" Value="WordEllipsis"/>
    </Style>
    <!-- Selectable text that looks like a label: copyable answers, questions, log details -->
    <Style x:Key="ReadOnlyText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text3}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text3}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>
    <Style x:Key="T.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    </Style>

    <!-- ═════════════════════════ Focus visual ═════════════════════════ -->
    <Style x:Key="Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{DynamicResource B.Text}" StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ Surfaces ═════════════════════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="CardInner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.CardInner}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="{DynamicResource B.Subtle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Divider" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource B.Divider}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═════════════════════════ Buttons ═════════════════════════ -->
    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ui:UiProps.HoverBackground" Value="{DynamicResource B.Subtle}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource B.SubtlePressed}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding (ui:UiProps.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding (ui:UiProps.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding (ui:UiProps.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="ui:UiProps.HoverBackground" Value="{DynamicResource B.AccentHover}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource B.Accent}"/>
    </Style>
    <Style x:Key="Btn.Standard" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource B.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}"/>
        <Setter Property="ui:UiProps.HoverBackground" Value="{DynamicResource B.ControlHover}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource B.Control}"/>
    </Style>
    <Style x:Key="Btn.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style x:Key="Btn.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
    </Style>
    <Style x:Key="Btn.Link" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Btn.Row" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ui:UiProps.CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Btn.Media" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ui:UiProps.CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="Btn.MediaMain" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Accent}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ui:UiProps.CornerRadius" Value="22"/>
    </Style>

    <!-- Chips (filters) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
        <Setter Property="Background" Value="{DynamicResource B.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.AccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation items -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, StringFormat=nav-{0}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Margin="6,0" Background="Transparent"/>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource B.Accent}"
                                HorizontalAlignment="Left" Margin="6,0,0,0" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" Margin="21,0,10,0" VerticalAlignment="Center">
                            <Grid Width="20" Height="20">
                                <c:Icon x:Name="Ico" Kind="{Binding (ui:UiProps.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="19" Height="19"/>
                                <Border x:Name="BadgeDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource B.Down}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                            <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource B.AccentText}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding (ui:UiProps.Badge), RelativeSource={RelativeSource Self}}" Value="dot">
                            <Setter TargetName="BadgeDot" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- Something new to look at (an update), rather than something wrong -->
                        <DataTrigger Binding="{Binding (ui:UiProps.Badge), RelativeSource={RelativeSource Self}}" Value="new">
                            <Setter TargetName="BadgeDot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BadgeDot" Property="Background" Value="{DynamicResource B.Accent}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource B.ControlStrokeStrong}" Background="Transparent"/>
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource B.Text2}" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Shift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource B.OnAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="14"/>
                            <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ Inputs ═════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding (ui:UiProps.Placeholder), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{Binding (ui:UiProps.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!-- WPF applies Padding to the text itself (inside PART_ContentHost), so only the placeholder is inset here:
                             by Padding plus the text host's own 2px, so the hint, the caret and typed text all start at the same x. -->
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <TextBlock x:Name="Ph" Text="{Binding (ui:UiProps.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource B.Text3}" Visibility="Collapsed" Margin="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,6,6"
                                Background="{DynamicResource B.Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="MinHeight" Value="34"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlFocus}"/>
                            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                        <!-- Padding is applied by the password box itself; adding it here too pushed the caret 11px right. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,6,6" Background="{DynamicResource B.Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlFocus}"/>
                            <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.ControlStroke}" BorderThickness="1" CornerRadius="6">
            <c:Icon Kind="chevron-down" Width="13" Height="13" HorizontalAlignment="Right" Margin="0,0,11,0" Foreground="{DynamicResource B.Text2}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Padding" Value="12,6,34,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" VerticalOffset="2" HorizontalOffset="-8">
                            <Border Margin="8,0,8,12" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Track}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource B.Accent}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="18" Height="18">
                                                <Ellipse Fill="{DynamicResource B.Popup}" Stroke="{DynamicResource B.ControlStroke}"/>
                                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource B.Accent}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Width" Value="12"/>
                                                    <Setter TargetName="Dot" Property="Height" Value="12"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars: slim, rounded, expand on hover -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="{DynamicResource B.Text3}" Opacity="0.55"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}" Width="4" HorizontalAlignment="Center"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}" Height="4" VerticalAlignment="Center"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Height" Value="7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToolTip -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1" CornerRadius="6"
                            Padding="9,6" MaxWidth="340" Margin="4">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10,4,10,14" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupStroke}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinWidth="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.32" Color="Black"/>
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <c:Icon Kind="{Binding (ui:UiProps.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource B.Text3}" FontSize="12"
                                       VerticalAlignment="Center" Margin="24,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="6,4" Fill="{DynamicResource B.Divider}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List items (palette, pickers) -->
    <Style x:Key="PlainListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"/>
                        <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource B.Accent}" HorizontalAlignment="Left" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                            <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource B.ControlStrokeStrong}" Background="Transparent">
                            <c:Icon x:Name="Tick" Kind="check" Width="13" Height="13" StrokeThickness="2.4" Foreground="{DynamicResource B.OnAccent}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card -->
    <Style TargetType="c:WeatherIcon">
        <Setter Property="CloudBrush" Value="{DynamicResource B.WeatherCloud}"/>
        <Setter Property="CloudEdgeBrush" Value="{DynamicResource B.WeatherCloudEdge}"/>
    </Style>

    <Style TargetType="c:Card">
        <Setter Property="Background" Value="{DynamicResource B.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.CardStroke}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Padding" Value="18,16,18,18"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Grid x:Name="Header" DockPanel.Dock="Top" Margin="0,0,0,12" MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource B.AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <c:Icon Kind="{TemplateBinding Icon}" Width="15" Height="15" Foreground="{DynamicResource B.AccentText}"/>
                                </Border>
                                <!-- Title and badge keep their size; a long subtitle is trimmed with an ellipsis (full text in its tooltip). -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource T.CardTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="BadgeBorder" Grid.Column="1" Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{DynamicResource B.AccentSoft}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="sparkle" Width="10" Height="10" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{TemplateBinding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource B.AccentText}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="SubtitleText" Grid.Column="2" Text="{TemplateBinding Subtitle}" ToolTip="{TemplateBinding Subtitle}"
                                               Style="{StaticResource T.Caption}" Margin="10,1,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderAction}" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="ToolTip" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="ToolTip" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting row -->
    <Style TargetType="c:SettingRow">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.CardStroke}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:Icon x:Name="Ico" Kind="{TemplateBinding Icon}" Width="18" Height="18" Margin="2,0,16,0" Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="14"/>
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter x:Name="BelowHost" Content="{TemplateBinding Below}" Margin="36,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BelowHost" Property="Margin" Value="0,10,0,0"/>
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Below" Value="{x:Null}">
                            <Setter TargetName="BelowHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <!-- The header takes the Expander's text colour (a bare ToggleButton would draw it in the system's black). -->
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True"
                                      Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon x:Name="Chev" Kind="chevron-right" Width="12" Height="12" Foreground="{DynamicResource B.Text2}" Margin="0,0,8,0"/>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Subtle}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chev" Property="Kind" Value="chevron-down"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding Header}"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource B.Track}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
