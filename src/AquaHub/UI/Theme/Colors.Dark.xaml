<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces (layered over Mica; an opaque fallback is used when transparency is unavailable) -->
    <SolidColorBrush x:Key="B.Window" Color="#FF15171B"/>
    <LinearGradientBrush x:Key="B.WindowOpaque" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF17191E" Offset="0"/>
        <GradientStop Color="#FF121418" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.Layer" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="B.LayerStroke" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="B.Card" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="B.CardHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="B.CardStroke" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="B.CardInner" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="B.Subtle" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="B.SubtlePressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="B.Control" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="B.ControlHover" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="B.ControlFocus" Color="#B3141619"/>
    <SolidColorBrush x:Key="B.ControlStroke" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="B.ControlStrokeStrong" Color="#8AFFFFFF"/>
    <SolidColorBrush x:Key="B.Divider" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="B.Track" Color="#1FFFFFFF"/>
    <LinearGradientBrush x:Key="B.WeatherCloud" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF7F9FC" Offset="0"/><GradientStop Color="#FFC9D3E0" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="B.WeatherCloudEdge" Color="#28000000"/>
    <SolidColorBrush x:Key="B.Popup" Color="#FF25282D"/>
    <SolidColorBrush x:Key="B.PopupStroke" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="B.Flyout" Color="#F21C1E22"/>
    <SolidColorBrush x:Key="B.Scrim" Color="#A6000000"/>
    <SolidColorBrush x:Key="B.Skeleton" Color="#12FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="B.Text" Color="#FFF3F5F7"/>
    <SolidColorBrush x:Key="B.Text2" Color="#C4FFFFFF"/>
    <SolidColorBrush x:Key="B.Text3" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="B.TextDisabled" Color="#5CFFFFFF"/>

    <!-- Accent (aqua) -->
    <SolidColorBrush x:Key="B.Accent" Color="#FF4FD8E6"/>
    <SolidColorBrush x:Key="B.AccentHover" Color="#FF72E3EE"/>
    <SolidColorBrush x:Key="B.AccentText" Color="#FF6FE3EF"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="#2E4FD8E6"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="#FF03272B"/>
    <LinearGradientBrush x:Key="B.Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2BE0D2" Offset="0"/>
        <GradientStop Color="#FF14A9E8" Offset="0.55"/>
        <GradientStop Color="#FF255CF0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2BE0D2" Offset="0"/>
        <GradientStop Color="#1414A9E8" Offset="0.45"/>
        <GradientStop Color="#08255CF0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Semantic -->
    <SolidColorBrush x:Key="B.Up" Color="#FF3DDC97"/>
    <SolidColorBrush x:Key="B.UpSoft" Color="#243DDC97"/>
    <SolidColorBrush x:Key="B.Down" Color="#FFFF6B7A"/>
    <SolidColorBrush x:Key="B.DownSoft" Color="#24FF6B7A"/>
    <SolidColorBrush x:Key="B.Warn" Color="#FFF5C451"/>
    <SolidColorBrush x:Key="B.WarnSoft" Color="#24F5C451"/>
    <SolidColorBrush x:Key="B.Info" Color="#FF7AB2FF"/>
    <SolidColorBrush x:Key="B.InfoSoft" Color="#247AB2FF"/>
    <SolidColorBrush x:Key="B.Neutral" Color="#FFB4BAC4"/>
    <SolidColorBrush x:Key="B.NeutralSoft" Color="#1FB4BAC4"/>

    <!-- Categories & platforms -->
    <SolidColorBrush x:Key="B.Cat.world" Color="#FF7AA7FF"/>
    <SolidColorBrush x:Key="B.Cat.local" Color="#FF3DD6C4"/>
    <SolidColorBrush x:Key="B.Cat.business" Color="#FFF5B84B"/>
    <SolidColorBrush x:Key="B.Cat.tech" Color="#FFB892FF"/>
    <SolidColorBrush x:Key="B.Cat.europe" Color="#FF5CC8FF"/>
    <SolidColorBrush x:Key="B.Cat.science" Color="#FF8BD17C"/>
    <SolidColorBrush x:Key="B.Plat.reddit" Color="#FFFF7A45"/>
    <SolidColorBrush x:Key="B.Plat.mastodon" Color="#FF9A8CFF"/>
    <SolidColorBrush x:Key="B.Plat.bluesky" Color="#FF4DA3FF"/>
    <SolidColorBrush x:Key="B.Plat.hackernews" Color="#FFFF9A3D"/>
    <SolidColorBrush x:Key="B.Plat.youtube" Color="#FFFF5A52"/>
    <SolidColorBrush x:Key="B.Plat.rss" Color="#FFF5A623"/>
    <Color x:Key="C.Shadow">#80000000</Color>
</ResourceDictionary>
