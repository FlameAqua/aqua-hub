<UserControl x:Class="AquaHub.UI.Controls.PersonalityWorkbench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource Btn.Accent}" Content="New personality" Click="OnNew" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="personality-new"/>
                    <Button Style="{StaticResource Btn.Link}" Content="Open Roleplay" Click="OnRoleplay"/>
                </WrapPanel>
                <TextBlock x:Name="EmptyLibrary" Text="Saved personalities appear here." Style="{StaticResource T.Caption}"/>
                <ListBox x:Name="LibraryList" SelectionChanged="OnSelection" MaxHeight="240" Style="{StaticResource PlainList}"
                         Foreground="{DynamicResource B.Text}"
                         AutomationProperties.Name="Saved personalities" AutomationProperties.AutomationId="personalities-list">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItem}">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel x:Name="LibraryActions" Margin="0,8,0,0">
                    <Button Style="{StaticResource Btn.Standard}" Content="Edit" Click="OnEdit" Margin="0,0,8,0" AutomationProperties.AutomationId="personality-edit"/>
                    <Button Style="{StaticResource Btn.Standard}" Content="Duplicate" Click="OnDuplicate" Margin="0,0,8,0" AutomationProperties.AutomationId="personality-duplicate"/>
                    <Button Style="{StaticResource Btn.Standard}" Content="Delete…" Click="OnDelete" AutomationProperties.AutomationId="personality-delete"/>
                </WrapPanel>
                <StackPanel x:Name="DeleteReview" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="DeleteWarning" Style="{StaticResource T.Body}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource Btn.Standard}" Content="Delete personality" Click="OnConfirmDelete" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="personality-delete-confirm"/>
                        <Button Style="{StaticResource Btn.Standard}" Content="Keep it" Click="OnKeep"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="Editor" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Style="{StaticResource T.CardTitle}"/>
                <Expander x:Name="DraftOptions" Header="Draft with AI" Margin="0,8,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <TextBox x:Name="Idea" MaxLength="1200" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="96"
                                 VerticalScrollBarVisibility="Auto" ui:UiProps.Placeholder="Describe the character you want"
                                 AutomationProperties.Name="Character idea" AutomationProperties.AutomationId="personality-idea"/>
                        <TextBlock x:Name="RemoteNotice" Text="Your description leaves this PC for the configured AI server."
                                   Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="DraftButton" Style="{StaticResource Btn.Standard}" Content="Generate draft" Click="OnDraft"
                                    AutomationProperties.AutomationId="personality-draft"/>
                            <Button Style="{StaticResource Btn.Link}" Content="Model settings" Click="OnModelSettings" Margin="8,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Name" Style="{StaticResource T.Caption}" Margin="0,8,0,4"/>
                <TextBox x:Name="NameBox" MaxLength="80" AutomationProperties.Name="Personality name" AutomationProperties.AutomationId="personality-name"/>
                <TextBlock Text="Character instructions" Style="{StaticResource T.Caption}" Margin="0,8,0,4"/>
                <TextBox x:Name="Instructions" MaxLength="1200" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Character instructions" AutomationProperties.AutomationId="personality-instructions"/>
                <TextBlock Text="Opening scenario (optional)" Style="{StaticResource T.Caption}" Margin="0,8,0,4"/>
                <TextBox x:Name="Scenario" MaxLength="1200" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Opening scenario" AutomationProperties.AutomationId="personality-scenario"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SaveButton" Style="{StaticResource Btn.Accent}" Content="Save personality" Click="OnSave" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="personality-save"/>
                    <Button Style="{StaticResource Btn.Standard}" Content="Close editor" Click="OnClose"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
