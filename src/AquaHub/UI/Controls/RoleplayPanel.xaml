<UserControl x:Class="AquaHub.UI.Controls.RoleplayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI"
             SizeChanged="OnPanelSizeChanged">
    <Grid x:Name="PanelLayout" Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Roleplay" Style="{StaticResource T.Title}"/>
            </StackPanel>
            <WrapPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ResetWarning" Text="New scene clears this conversation." Style="{StaticResource T.Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="CopyTranscript" Style="{StaticResource Btn.Standard}" Content="Copy transcript" Click="OnCopy" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Standard}" Content="New scene" Click="OnNewScene" AutomationProperties.AutomationId="roleplay-new-scene"/>
            </WrapPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SceneSetup" Grid.Column="0" Style="{StaticResource Card}" Padding="12" CornerRadius="14">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <c:HintButton x:Name="ModelHint" DockPanel.Dock="Right" AutomationProperties.Name="About Roleplay"/>
                        <TextBlock Text="Scene" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Personality for next scene" Style="{StaticResource T.Caption}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PersonalityPicker" AutomationProperties.Name="Personality for next scene"
                              AutomationProperties.AutomationId="roleplay-personality" SelectionChanged="OnPersonalityPicked">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Margin="0,4,0,4">
                        <Button Style="{StaticResource Btn.Link}" Content="Manage personalities" Click="OnManage" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="roleplay-manage"/>
                        <Button Style="{StaticResource Btn.Link}" Content="Model settings" Click="OnModelSettings"/>
                    </WrapPanel>
                    <TextBlock x:Name="CurrentModel" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="roleplay-model"/>
                    <TextBlock x:Name="ActivePersonality" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RemoteNotice" Text="Your scene and messages leave this PC for the configured AI server."
                               Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <Expander x:Name="SceneDetails" Header="Scene details" IsExpanded="True" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Persona" Style="{StaticResource T.Caption}" Margin="0,5,0,4"/>
                            <TextBox x:Name="PersonaBox" ui:UiProps.Placeholder="Who should the model play?" TextChanged="OnSceneEdited" MaxLength="1200"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="72" MinHeight="36" Padding="10,7"
                                     AutomationProperties.Name="Persona" AutomationProperties.AutomationId="roleplay-persona"/>
                            <TextBlock Text="Scenario" Style="{StaticResource T.Caption}" Margin="0,8,0,4"/>
                            <TextBox x:Name="ScenarioBox" ui:UiProps.Placeholder="Where does the scene begin?" TextChanged="OnSceneEdited" MaxLength="1200"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="94"
                                     Padding="10,8" AutomationProperties.Name="Scenario" AutomationProperties.AutomationId="roleplay-scenario"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <Border x:Name="ConversationCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock x:Name="EmptyState" Text="Write the first line of your scene."
                                       Style="{StaticResource T.Body2}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="390" Margin="24"/>
                            <ItemsControl x:Name="Transcript" AutomationProperties.AutomationId="roleplay-transcript">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="YOU" Style="{StaticResource T.Overline}" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding UserText}" Style="{StaticResource T.Body}" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Persona}" Style="{StaticResource T.Overline}" Margin="0,0,0,5"/>
                                            <c:MarkdownView Markdown="{Binding Answer}" FontSize="14" AutomationProperties.Name="Roleplay reply"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" ui:UiProps.Placeholder="Write your next line…" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1200" TextChanged="OnDraftEdited"
                                     MinHeight="48" MaxHeight="126" Padding="12,10" ui:UiProps.CornerRadius="10" KeyDown="OnInputKeyDown"
                                     AutomationProperties.Name="Your line" AutomationProperties.AutomationId="roleplay-input"/>
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource Btn.Accent}" Content="Send" MinWidth="76" Height="42"
                                    Margin="10,0,0,0" Click="OnSend" AutomationProperties.AutomationId="roleplay-send"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource Btn.Standard}" Content="Stop" MinWidth="76" Height="42"
                                    Margin="10,0,0,0" Click="OnCancel" Visibility="Collapsed" AutomationProperties.AutomationId="roleplay-cancel"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <c:FeedbackPopup x:Name="RoleplayFeedback" Grid.RowSpan="2" NoticeAlignment="Left" AlignBottom="True"/>
    </Grid>
</UserControl>
