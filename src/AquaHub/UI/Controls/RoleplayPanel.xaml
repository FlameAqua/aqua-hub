<UserControl x:Class="AquaHub.UI.Controls.RoleplayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AquaHub.UI.Controls"
             xmlns:ui="clr-namespace:AquaHub.UI"
             SizeChanged="OnPanelSizeChanged">
    <Grid x:Name="PanelLayout" Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Roleplay" Style="{StaticResource T.Title}"/>
                <TextBlock Text="Shape a scene together, one turn at a time." Style="{StaticResource T.Body2}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Standard}" Content="Copy transcript" Click="OnCopy" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Standard}" Content="New scene" Click="OnNewScene" AutomationProperties.AutomationId="roleplay-new-scene"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SceneSetup" Grid.Column="0" Style="{StaticResource Card}" Padding="16" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="SCENE SETUP" Style="{StaticResource T.Overline}" Margin="0,0,0,12"/>
                    <TextBlock Text="Persona" Style="{StaticResource T.Caption}" Margin="0,0,0,5"/>
                    <TextBox x:Name="PersonaBox" ui:UiProps.Placeholder="Who should the model play?" TextChanged="OnSceneEdited" MaxLength="300"
                             MinHeight="36" Padding="10,7" ui:UiProps.CornerRadius="8" AutomationProperties.AutomationId="roleplay-persona"/>
                    <TextBlock Text="Scenario" Style="{StaticResource T.Caption}" Margin="0,14,0,5"/>
                    <TextBox x:Name="ScenarioBox" ui:UiProps.Placeholder="Where does the scene begin?" TextChanged="OnSceneEdited" MaxLength="1200"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="116" MaxHeight="190"
                             Padding="10,8" ui:UiProps.CornerRadius="8" AutomationProperties.AutomationId="roleplay-scenario"/>
                    <TextBlock x:Name="ModelLabel" Text="Uses your configured AI model" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="ConversationCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock x:Name="EmptyState" Text="Your scene starts here. Set a persona and scenario, then write the first line."
                                       Style="{StaticResource T.Body2}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="390" Margin="24"/>
                            <ItemsControl x:Name="Transcript" AutomationProperties.AutomationId="roleplay-transcript">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="YOU" Style="{StaticResource T.Overline}" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding UserText}" Style="{StaticResource T.Body}" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Persona}" Style="{StaticResource T.Overline}" Margin="0,0,0,5"/>
                                            <c:MarkdownView Markdown="{Binding Answer}" FontSize="14" AutomationProperties.Name="Roleplay reply"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready when you are." Style="{StaticResource T.Caption}" Margin="2,0,0,7"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputBox" ui:UiProps.Placeholder="Write your next line…" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1200" TextChanged="OnDraftEdited"
                                     MinHeight="48" MaxHeight="126" Padding="12,10" ui:UiProps.CornerRadius="10" KeyDown="OnInputKeyDown"
                                     AutomationProperties.AutomationId="roleplay-input"/>
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource Btn.Accent}" Content="Send" MinWidth="76" Height="42"
                                    Margin="10,0,0,0" Click="OnSend" AutomationProperties.AutomationId="roleplay-send"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource Btn.Standard}" Content="Stop" MinWidth="76" Height="42"
                                    Margin="10,0,0,0" Click="OnCancel" Visibility="Collapsed" AutomationProperties.AutomationId="roleplay-cancel"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
