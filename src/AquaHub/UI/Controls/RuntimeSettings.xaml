<UserControl x:Class="AquaHub.UI.Controls.RuntimeSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:AquaHub.UI.Controls" xmlns:ui="clr-namespace:AquaHub.UI">
 <StackPanel>
  <c:GroupBorder Style="{StaticResource Card}" Margin="0,12,0,12" AutomationProperties.AutomationId="settings-ai-runtime" AutomationProperties.Name="Aqua runtime">
   <StackPanel>
    <TextBlock Text="Aqua's own runtime" Style="{StaticResource T.CardTitle}"/>
    <TextBlock x:Name="Status" Style="{StaticResource T.Body2}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel>
     <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Btn.Accent}" Click="OnInstall" Margin="0,0,8,6" AutomationProperties.AutomationId="settings-ai-runtime-install"/>
     <Button x:Name="UseButton" Content="Use this runtime" Style="{StaticResource Btn.Accent}" Click="OnUse" Margin="0,0,8,6" AutomationProperties.AutomationId="settings-ai-runtime-use"/>
     <Button x:Name="DevicesButton" Content="Check devices" Style="{StaticResource Btn.Standard}" Click="OnDevices" Margin="0,0,8,6" AutomationProperties.AutomationId="settings-ai-runtime-devices"/>
     <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource Btn.Standard}" Click="OnRemove" Margin="0,0,8,6" AutomationProperties.AutomationId="settings-ai-runtime-remove"/>
     <Button Content="Open model library" Style="{StaticResource Btn.Standard}" Click="OnModels" Margin="0,0,0,6"/>
    </WrapPanel>
    <Expander x:Name="OtherBuilds" Header="Other builds" Foreground="{DynamicResource B.Text}" Margin="0,8,0,0">
     <StackPanel Margin="18,10,0,0"><TextBlock Text="The recommended build is matched to your card and driver." Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ComboBox x:Name="BuildChoice" DisplayMemberPath="Label" SelectionChanged="OnBuildChanged" AutomationProperties.Name="Runtime build" MaxWidth="410" HorizontalAlignment="Left">
       <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ComboBox.ItemContainerStyle>
      </ComboBox>
     </StackPanel>
    </Expander>
    <StackPanel x:Name="ProgressPanel" Margin="0,10,0,0">
     <TextBlock x:Name="ProgressText" Style="{StaticResource T.Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar x:Name="Progress" Height="5" Maximum="100" Margin="0,8,0,10" AutomationProperties.Name="Runtime installation progress"/>
     <Button Content="Cancel" Style="{StaticResource Btn.Standard}" Click="OnCancel" HorizontalAlignment="Left"/>
    </StackPanel>
    <TextBlock x:Name="DeviceText" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource B.Down}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </c:GroupBorder>
  <Expander Header="Advanced runtime settings" Foreground="{DynamicResource B.Text}" Margin="0,0,0,14" AutomationProperties.AutomationId="settings-ai-advanced">
   <StackPanel Margin="0,12,0,0">
    <TextBlock Text="Changes apply the next time a model starts. Stop a running model in the library to reload it with these settings." Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="4,0,4,10"/>
    <c:SettingRow Title="Context tokens" Description="0 = automatic for your card. Larger context needs more memory." Keywords="llama context memory">
     <TextBox Text="{Binding Ai.Llama.ContextTokens, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" AutomationProperties.AutomationId="settings-ai-context"/>
    </c:SettingRow>
    <c:SettingRow Title="Cache type" Description="Memory used to remember the conversation.">
     <c:SettingRow.Below><ComboBox SelectedValue="{Binding Ai.Llama.CacheType}" SelectedValuePath="Tag" AutomationProperties.Name="Cache type" AutomationProperties.AutomationId="settings-ai-cache">
      <ComboBoxItem Content="q8_0 · Recommended: half the memory, near-identical answers" Tag="q8_0"/>
      <ComboBoxItem Content="f16 · Exact, twice the memory" Tag="f16"/>
      <ComboBoxItem Content="q4_0 · Smallest, slightly worse at long contexts" Tag="q4_0"/>
     </ComboBox></c:SettingRow.Below>
    </c:SettingRow>
    <c:SettingRow Title="Multi-token prediction" Description="MTP can make compatible models write faster. Automatic measures both modes." Keywords="mtp speculative speed">
     <ComboBox SelectedValue="{Binding Ai.Llama.Mtp}" SelectedValuePath="Tag" Width="200" AutomationProperties.AutomationId="settings-ai-mtp">
      <ComboBoxItem Content="Automatic (measured)" Tag="auto"/><ComboBoxItem Content="On" Tag="on"/><ComboBoxItem Content="Off" Tag="off"/>
     </ComboBox>
    </c:SettingRow>
    <c:SettingRow Title="Unload after idle minutes" Description="Free the model's memory while you're away. 0 keeps it loaded.">
     <TextBox Text="{Binding Ai.Llama.IdleUnloadMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120"/>
    </c:SettingRow>
    <c:SettingRow Title="Processor threads" Description="0 = half the processor cores.">
     <TextBox Text="{Binding Ai.Llama.CpuThreads, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120"/>
    </c:SettingRow>
    <c:SettingRow Title="Reasoning effort" Description="For models whose template supports an effort setting.">
     <ComboBox SelectedValue="{Binding Ai.Llama.ReasoningEffort}" SelectedValuePath="Tag" Width="160">
      <ComboBoxItem Content="Low" Tag="low"/><ComboBoxItem Content="Medium" Tag="medium"/><ComboBoxItem Content="High" Tag="high"/>
     </ComboBox>
    </c:SettingRow>
    <c:SettingRow Title="Models folder" Description="Leave empty to use the profile's models folder. Use a full local drive path.">
     <c:SettingRow.Below><TextBox Text="{Binding Ai.Llama.ModelsFolder, UpdateSourceTrigger=LostFocus}" ui:UiProps.Placeholder="Default models folder" AutomationProperties.Name="Models folder" AutomationProperties.AutomationId="settings-ai-models-folder"/></c:SettingRow.Below>
    </c:SettingRow>
    <c:SettingRow Title="Use the models Ollama has downloaded" Description="Read them in place, without making a second copy.">
     <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Ai.Llama.UseOllamaModels}" AutomationProperties.AutomationId="settings-ai-ollama-models"/>
    </c:SettingRow>
    <c:SettingRow Title="Server path (custom)" Description="Optional local path ending in llama-server.exe. Leave empty to use Aqua's install.">
     <c:SettingRow.Below><TextBox Text="{Binding Ai.Llama.ServerPath, UpdateSourceTrigger=LostFocus}" ui:UiProps.Placeholder="Automatic" AutomationProperties.Name="Server path (custom)" AutomationProperties.AutomationId="settings-ai-server-path"/></c:SettingRow.Below>
    </c:SettingRow>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
