<Project>
  <!--
    One target framework: .NET 10 (LTS). It's fixed rather than chosen from the installed SDK, because the
    packages.lock.json files are for this framework and the locked restore (CI, release, scripts/build.ps1) fails
    for any other. global.json picks the SDK; changing framework means regenerating the lock files
    (dotnet restore -force-evaluate) and the release's vpk framework in one commit.
  -->
  <PropertyGroup>
    <AquaNet>net10.0</AquaNet>
    <AquaWindowsTfm>$(AquaNet)-windows10.0.19041.0</AquaWindowsTfm>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Authors>Aqua Hub</Authors>
    <Product>Aqua Hub</Product>
    <Copyright>Personal use</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Reproducible, audited restores -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
